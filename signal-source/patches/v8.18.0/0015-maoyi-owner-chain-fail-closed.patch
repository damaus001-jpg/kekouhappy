+
+/**
+ * Verify an existing top-level owner relationship without changing either
+ * window's visibility, position, size, z-order, or activation state.
+ */
+export function hasWindowOwner(
+  childHandle: Buffer<ArrayBuffer>,
+  ownerHandle: Buffer<ArrayBuffer>,
+  ownerProcessId: number,
+): boolean {
+  if (!binding) {
+    throw new Error('This library works only on Windows');
+  }
+  return binding.hasWindowOwner(childHandle, ownerHandle, ownerProcessId);
+}
