+import { hasWindowOwner, setWindowOwner } from '@signalapp/windows-ucv';
 import type { BrowserWindow } from 'electron';
 
 export type MaoyiOwnerDescriptor = Readonly<{
@@ -23,3 +23,18 @@ export function applyMaoyiWindowOwner(
