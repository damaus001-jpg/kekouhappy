+  if (
+    message.textAttachment?.contentType?.toLowerCase() !==
+    'text/x-signal-plain'
+  ) {
+    return false;
+  }
+
+  // Signal keeps only a <= 2 KiB inline preview until a long-message attachment
+  // has been decoded. Publishing only bodies above that boundary prevents a
+  // partial preview from being translated and cached as if it were complete.
