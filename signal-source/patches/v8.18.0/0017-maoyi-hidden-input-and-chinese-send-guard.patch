diff --git a/ts/test-node/maoyi/outgoingTextGuard_test.node.ts b/ts/test-node/maoyi/outgoingTextGuard_test.node.ts
new file mode 100644
index 0000000..bab4ae0
--- /dev/null
+++ b/ts/test-node/maoyi/outgoingTextGuard_test.node.ts
@@ -0,0 +1,32 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import assert from 'node:assert/strict';
+
+import {
+  assertMaoyiOutgoingTextAllowed,
+  containsMaoyiBlockedChineseText,
+  MaoyiOutgoingTextBlockedError,
+} from '../../maoyi/outgoingTextGuard.std.ts';
+
+describe('Maoyi outgoing text guard', () => {
+  it('blocks Chinese and mixed Chinese/English text before send', () => {
+    const mixed =
+      '今天和我的好朋友CoCo度过了愉快的一天。我买了几件衣服，她还送了我一个包';
+    assert.equal(containsMaoyiBlockedChineseText(mixed), true);
+    assert.throws(() => assertMaoyiOutgoingTextAllowed(mixed), {
+      name: MaoyiOutgoingTextBlockedError.name,
+    });
+  });
+
+  it('allows reviewed English and standalone URLs', () => {
+    assert.doesNotThrow(() =>
+      assertMaoyiOutgoingTextAllowed(
+        'I had a lovely day with my good friend CoCo'
+      )
+    );
+    assert.doesNotThrow(() =>
+      assertMaoyiOutgoingTextAllowed('https://example.com/path?a=1')
+    );
+  });
+});
