diff --git a/ts/maoyi/outgoingTextGuard.std.ts b/ts/maoyi/outgoingTextGuard.std.ts
new file mode 100644
index 0000000..e03abaa
--- /dev/null
+++ b/ts/maoyi/outgoingTextGuard.std.ts
@@ -0,0 +1,28 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+export const maoyiOutgoingTextGuardVersion =
+  'df.signal.outgoing-text-guard.v1' as const;
+
+const hanTextPattern = /\p{Script=Han}/u;
+
+export class MaoyiOutgoingTextBlockedError extends Error {
+  constructor() {
+    super('Maoyi blocked outgoing text containing Chinese characters');
+    this.name = 'MaoyiOutgoingTextBlockedError';
+  }
+}
+
+export function containsMaoyiBlockedChineseText(
+  value: string | undefined
+): boolean {
+  return Boolean(value && hanTextPattern.test(value));
+}
+
+export function assertMaoyiOutgoingTextAllowed(
+  value: string | undefined
+): void {
+  if (containsMaoyiBlockedChineseText(value)) {
+    throw new MaoyiOutgoingTextBlockedError();
+  }
+}
