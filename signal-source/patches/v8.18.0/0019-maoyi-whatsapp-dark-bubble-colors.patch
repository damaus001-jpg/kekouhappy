diff --git a/stylesheets/_modules.scss b/stylesheets/_modules.scss
--- a/stylesheets/_modules.scss
+++ b/stylesheets/_modules.scss
@@ -6548,3 +6548,26 @@
   margin-top: 4px;
   margin-bottom: 4px;
 }
+
+// Maoyi: keep every profile visually aligned with the active theme even
+// when Signal has persisted a conversation-specific outgoing color.
+.light-theme .module-message__container--outgoing {
+  background-color: #2c6bed !important;
+  background-image: none !important;
+}
+
+.light-theme .module-message__container--incoming {
+  background-color: #e9e9e9 !important;
+  background-image: none !important;
+}
+
+// Match the approved WhatsApp palette only while Signal is in dark mode.
+.dark-theme .module-message__container--outgoing {
+  background-color: #144d37 !important;
+  background-image: none !important;
+}
+
+.dark-theme .module-message__container--incoming {
+  background-color: #242626 !important;
+  background-image: none !important;
+}
