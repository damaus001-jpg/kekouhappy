+export function applyMaoyiTranslationRefreshStatus(
+  status: MaoyiTranslationRefreshStatus
+): void {
+  const key = translationKey(status.conversationId, status.messageId);
+  if (status.state === 'processing') {
+    if (refreshRequests.get(key) === status.requestId) return;
+    refreshRequests.set(key, status.requestId);
+    notifySubscribers();
+    return;
+  }
+  if (refreshRequests.get(key) !== status.requestId) return;
+  refreshRequests.delete(key);
+  notifySubscribers();
+}
