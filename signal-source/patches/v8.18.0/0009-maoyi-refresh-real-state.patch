+// oxlint-disable-next-line max-classes-per-file
+export class MaoyiTranslationRefreshLedger {
+  readonly #entries = new Map<
+    string,
+    Readonly<{
+      conversationId: string;
+      messageId: string;
+      state: 'accepted' | 'processing';
+      expiresAt: number;
+    }>
+  >();
+  readonly #now: () => number;
+  readonly #limit: number;
+  readonly #ttlMs: number;
+
+  constructor(
+    now: () => number = Date.now,
+    limit = maoyiRequestCorrelationLimit,
+    ttlMs = maoyiRefreshCorrelationTtlMs
+  ) {
+    this.#now = now;
+    this.#limit = limit;
+    this.#ttlMs = ttlMs;
+  }
+
+  #prune(): void {
+    const now = this.#now();
+    for (const [requestId, entry] of this.#entries) {
+      if (entry.expiresAt <= now) this.#entries.delete(requestId);
+    }
+  }
+
+  begin(request: TranslationRefreshRequest): boolean {
+    this.#prune();
+    if (this.#entries.has(request.requestId)) return false;
+    while (this.#entries.size >= this.#limit) {
+      const oldest = this.#entries.keys().next();
+      if (oldest.done) return false;
+      this.#entries.delete(oldest.value);
+    }
+    this.#entries.set(request.requestId, {
+      conversationId: request.conversationId,
+      messageId: request.messageId,
+      state: 'accepted',
+      expiresAt: this.#now() + this.#ttlMs,
+    });
+    return true;
+  }
+
+  acceptStatus(status: TranslationRefreshStatus): boolean {
+    this.#prune();
+    const entry = this.#entries.get(status.requestId);
+    if (
+      !entry ||
+      entry.conversationId !== status.conversationId ||
+      entry.messageId !== status.messageId
+    ) {
+      return false;
+    }
+    if (status.state === 'idle') {
+      this.#entries.delete(status.requestId);
+      return true;
+    }
+    this.#entries.set(status.requestId, {
+      ...entry,
+      state: 'processing',
+      expiresAt: this.#now() + this.#ttlMs,
+    });
+    return true;
+  }
+
+  remove(requestId: string): void {
+    this.#entries.delete(requestId);
+  }
+
+  clear(): void {
+    this.#entries.clear();
+  }
+}
