@@ -0,0 +1,120 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import assert from 'node:assert/strict';
+
+import { parseMaoyiControlCommand } from '../../../app/maoyi/controlProtocol.node.ts';
+import { MaoyiTranslationRefreshLedger } from '../../../app/maoyi/messageBridge.main.ts';
+import {
+  applyMaoyiTranslationRefreshStatus,
+  clearMaoyiTranslationRuntime,
+  getMaoyiTranslationRefreshPending,
+} from '../../maoyi/translationRuntime.preload.ts';
+import { legacyMaoyiSourceHash } from '../../maoyi/messageProjection.std.ts';
+
+describe('Maoyi real translation refresh state', () => {
+  const requestId = '11111111-1111-4111-8111-111111111111';
+  const nextRequestId = '55555555-5555-4555-8555-555555555555';
+  const conversationId = '22222222-2222-4222-8222-222222222222';
+  const messageId = '33333333-3333-4333-8333-333333333333';
+  const projection = {
+    conversationId,
+    messageId,
+    sourceHash: legacyMaoyiSourceHash('hello'),
+    sourceText: 'hello',
+    direction: 'incoming' as const,
+    timestamp: 1_800_000_000_000,
+  };
+
+  afterEach(() => {
+    clearMaoyiTranslationRuntime();
+  });
+
+  it('parses only the strict authenticated status shape', () => {
+    const status = {
+      type: 'translation.refresh.status',
+      requestId,
+      conversationId,
+      messageId,
+      state: 'processing',
+    } as const;
+    assert.deepEqual(parseMaoyiControlCommand(status), status);
+    assert.equal(
+      parseMaoyiControlCommand({ ...status, sourceText: 'must not cross' }),
+      undefined
+    );
+    assert.equal(
+      parseMaoyiControlCommand({ ...status, state: 'queued' }),
+      undefined
+    );
+  });
+
+  it('correlates status with the exact renderer refresh request', () => {
+    const ledger = new MaoyiTranslationRefreshLedger();
+    const request = {
+      type: 'translation.refresh.request',
+      requestId,
+      ...projection,
+    } as const;
+    assert.equal(ledger.begin(request), true);
+    assert.equal(
+      ledger.acceptStatus({
+        type: 'translation.refresh.status',
+        requestId,
+        conversationId,
+        messageId,
+        state: 'processing',
+      }),
+      true
+    );
+    assert.equal(
+      ledger.acceptStatus({
+        type: 'translation.refresh.status',
+        requestId,
+        conversationId,
+        messageId: nextRequestId,
+        state: 'idle',
+      }),
+      false
+    );
+    assert.equal(
+      ledger.acceptStatus({
+        type: 'translation.refresh.status',
+        requestId,
+        conversationId,
+        messageId,
+        state: 'idle',
+      }),
+      true
+    );
+  });
+
+  it('does not let an older completion clear a newer request', () => {
+    applyMaoyiTranslationRefreshStatus({
+      requestId,
+      conversationId,
+      messageId,
+      state: 'processing',
+    });
+    applyMaoyiTranslationRefreshStatus({
+      requestId: nextRequestId,
+      conversationId,
+      messageId,
+      state: 'processing',
+    });
+    applyMaoyiTranslationRefreshStatus({
+      requestId,
+      conversationId,
+      messageId,
+      state: 'idle',
+    });
+    assert.equal(getMaoyiTranslationRefreshPending(projection), true);
+    applyMaoyiTranslationRefreshStatus({
+      requestId: nextRequestId,
+      conversationId,
+      messageId,
+      state: 'idle',
+    });
+    assert.equal(getMaoyiTranslationRefreshPending(projection), false);
+  });
+});
