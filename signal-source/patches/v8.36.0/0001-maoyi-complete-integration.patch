diff --git a/ts/maoyi/smartReplyContext.std.ts b/ts/maoyi/smartReplyContext.std.ts
new file mode 100644
index 0000000000000000000000000000000000000000..59b683421c5b26b7985f64e62f7060b413e256be
--- /dev/null
+++ b/ts/maoyi/smartReplyContext.std.ts
@@ -0,0 +1,111 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import type { MaoyiMessageProjection } from './messageProjection.std.ts';
+
+export const maoyiSmartReplyContextVersion =
+  'df.signal.smart-reply-context.v1' as const;
+export const maoyiSmartReplyMaximumContextMessages = 8;
+export const maoyiSmartReplyMaximumTriggerMessages = 3;
+
+export type MaoyiSmartReplySuggestionId = 'reply_1' | 'reply_2' | 'reply_3';
+
+export type MaoyiSmartReplySuggestion = Readonly<{
+  id: MaoyiSmartReplySuggestionId;
+  english: string;
+  chinese: string;
+}>;
+
+export type MaoyiSmartReplyErrorCode =
+  | 'unavailable'
+  | 'rate-limited'
+  | 'timeout'
+  | 'invalid-response'
+  | 'request-failed';
+
+function projectionsExactlyMatch(
+  left: MaoyiMessageProjection,
+  right: MaoyiMessageProjection
+): boolean {
+  return (
+    left.conversationId === right.conversationId &&
+    left.messageId === right.messageId &&
+    left.sourceHash === right.sourceHash &&
+    left.sourceText === right.sourceText &&
+    left.direction === right.direction &&
+    left.timestamp === right.timestamp
+  );
+}
+
+export function selectMaoyiSmartReplyContext(
+  conversationId: string,
+  messages: ReadonlyArray<MaoyiMessageProjection>,
+  trigger?: MaoyiMessageProjection
+): ReadonlyArray<MaoyiMessageProjection> {
+  const seen = new Set<string>();
+  for (const message of messages) {
+    const normalizedMessageId = message.messageId.toLowerCase();
+    if (
+      message.conversationId !== conversationId ||
+      seen.has(normalizedMessageId)
+    ) {
+      return [];
+    }
+    seen.add(normalizedMessageId);
+  }
+
+  const eligibleTriggerIds = selectMaoyiSmartReplyTriggerIds(
+    conversationId,
+    messages
+  );
+  const selectedTrigger = trigger ?? messages.at(-1);
+  if (
+    !selectedTrigger ||
+    !eligibleTriggerIds.includes(selectedTrigger.messageId)
+  ) {
+    return [];
+  }
+  const triggerIndex = messages.findIndex(message =>
+    projectionsExactlyMatch(message, selectedTrigger)
+  );
+  if (triggerIndex < 0) {
+    return [];
+  }
+  return messages.slice(
+    Math.max(0, triggerIndex - maoyiSmartReplyMaximumContextMessages + 1),
+    triggerIndex + 1
+  );
+}
+
+export function selectMaoyiSmartReplyTriggerIds(
+  conversationId: string,
+  messages: ReadonlyArray<MaoyiMessageProjection>
+): ReadonlyArray<string> {
+  const seen = new Set<string>();
+  for (const message of messages) {
+    const normalizedMessageId = message.messageId.toLowerCase();
+    if (
+      message.conversationId !== conversationId ||
+      seen.has(normalizedMessageId)
+    ) {
+      return [];
+    }
+    seen.add(normalizedMessageId);
+  }
+  return messages
+    .filter(message => message.direction === 'incoming')
+    .slice(-maoyiSmartReplyMaximumTriggerMessages)
+    .map(message => message.messageId);
+}
+
+export function isMaoyiSmartReplyTrigger(
+  trigger: MaoyiMessageProjection,
+  context: ReadonlyArray<MaoyiMessageProjection>
+): boolean {
+  const latest = context.at(-1);
+  return Boolean(
+    latest &&
+    latest.direction === 'incoming' &&
+    projectionsExactlyMatch(latest, trigger)
+  );
+}
diff --git a/ts/maoyi/smartReplyRuntime.preload.ts b/ts/maoyi/smartReplyRuntime.preload.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ded3fc312e4b443bf4b5f0ca7d9879ba770b8bbc
--- /dev/null
+++ b/ts/maoyi/smartReplyRuntime.preload.ts
@@ -0,0 +1,135 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+// The runtime is deliberately preload-scoped because authenticated IPC owns it.
+// oxlint-disable-next-line signal-desktop/enforce-file-suffix
+import { useSyncExternalStore } from 'react';
+
+import type { MaoyiMessageProjection } from './messageProjection.std.ts';
+import type { MaoyiSmartReplySuggestion } from './smartReplyContext.std.ts';
+
+type SmartReplySnapshot = Readonly<{
+  trigger: MaoyiMessageProjection;
+  replies: ReadonlyArray<MaoyiSmartReplySuggestion>;
+}>;
+
+const emptyReplies: ReadonlyArray<MaoyiSmartReplySuggestion> = Object.freeze(
+  []
+);
+const listeners = new Set<() => void>();
+const snapshots = new Map<string, SmartReplySnapshot>();
+const pendingTriggers = new Map<string, MaoyiMessageProjection>();
+
+function triggerKey(trigger: MaoyiMessageProjection): string {
+  return `${trigger.conversationId}::${trigger.messageId.toLowerCase()}`;
+}
+
+function projectionsExactlyMatch(
+  left: MaoyiMessageProjection,
+  right: MaoyiMessageProjection
+): boolean {
+  return (
+    left.conversationId === right.conversationId &&
+    left.messageId === right.messageId &&
+    left.sourceHash === right.sourceHash &&
+    left.sourceText === right.sourceText &&
+    left.direction === right.direction &&
+    left.timestamp === right.timestamp
+  );
+}
+
+function emit(): void {
+  for (const listener of listeners) {
+    listener();
+  }
+}
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export function applyMaoyiSmartReplyResult(
+  trigger: MaoyiMessageProjection,
+  replies: ReadonlyArray<MaoyiSmartReplySuggestion>
+): void {
+  const key = triggerKey(trigger);
+  pendingTriggers.delete(key);
+  snapshots.set(
+    key,
+    Object.freeze({
+      trigger,
+      replies: Object.freeze(replies.map(reply => Object.freeze({ ...reply }))),
+    })
+  );
+  emit();
+}
+
+export function applyMaoyiSmartReplyPending(
+  trigger: MaoyiMessageProjection
+): void {
+  const key = triggerKey(trigger);
+  pendingTriggers.set(key, trigger);
+  snapshots.delete(key);
+  emit();
+}
+
+export function clearMaoyiSmartReplyRuntime(): void {
+  if (!snapshots.size && !pendingTriggers.size) {
+    return;
+  }
+  snapshots.clear();
+  pendingTriggers.clear();
+  emit();
+}
+
+export function clearMaoyiSmartReplyForTrigger(
+  trigger: MaoyiMessageProjection
+): void {
+  const key = triggerKey(trigger);
+  const removedSnapshot = snapshots.delete(key);
+  const removedPending = pendingTriggers.delete(key);
+  if (removedSnapshot || removedPending) emit();
+}
+
+export function getMaoyiSmartReplyPending(
+  trigger: MaoyiMessageProjection | undefined
+): boolean {
+  if (!trigger) return false;
+  const pendingTrigger = pendingTriggers.get(triggerKey(trigger));
+  return Boolean(
+    pendingTrigger && projectionsExactlyMatch(trigger, pendingTrigger)
+  );
+}
+
+export function getMaoyiSmartReplies(
+  trigger: MaoyiMessageProjection | undefined
+): ReadonlyArray<MaoyiSmartReplySuggestion> {
+  if (!trigger) {
+    return emptyReplies;
+  }
+  const snapshot = snapshots.get(triggerKey(trigger));
+  if (!snapshot || !projectionsExactlyMatch(trigger, snapshot.trigger))
+    return emptyReplies;
+  return snapshot.replies;
+}
+
+export function useMaoyiSmartReplies(
+  trigger: MaoyiMessageProjection | undefined
+): ReadonlyArray<MaoyiSmartReplySuggestion> {
+  return useSyncExternalStore(
+    subscribe,
+    () => getMaoyiSmartReplies(trigger),
+    () => emptyReplies
+  );
+}
+
+export function useMaoyiSmartReplyPending(
+  trigger: MaoyiMessageProjection | undefined
+): boolean {
+  return useSyncExternalStore(
+    subscribe,
+    () => getMaoyiSmartReplyPending(trigger),
+    () => false
+  );
+}
diff --git a/ts/maoyi/translationRuntime.preload.ts b/ts/maoyi/translationRuntime.preload.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0fde72aa76f1fc9ac682ec23bbd7f03352559b3e
--- /dev/null
+++ b/ts/maoyi/translationRuntime.preload.ts
@@ -0,0 +1,326 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+// The runtime is deliberately preload-scoped even before its IPC adapter is added.
+// oxlint-disable-next-line signal-desktop/enforce-file-suffix
+import { useCallback, useEffect, useSyncExternalStore } from 'react';
+
+import {
+  maoyiTranslationMatchesProjection,
+  legacyMaoyiSourceHash,
+  normalizeMaoyiSourceText,
+  type MaoyiMessageProjection,
+  type MaoyiTranslationResult,
+} from './messageProjection.std.ts';
+
+export const maoyiTranslationEntryLimit = 1_500;
+export const maoyiTranslationByteLimit = 15 * 1024 * 1024;
+
+const maximumIdentityLength = 256;
+const maximumTranslationLength = 30_000;
+
+type StoredMaoyiTranslation = MaoyiTranslationResult &
+  Readonly<{
+    estimatedBytes: number;
+  }>;
+
+type TranslationRuntimeStats = Readonly<{
+  entries: number;
+  estimatedBytes: number;
+}>;
+
+const translations = new Map<string, StoredMaoyiTranslation>();
+const refreshRequests = new Map<string, string>();
+const refreshErrors = new Map<string, string>();
+const refreshTimers = new Map<string, ReturnType<typeof setTimeout>>();
+const subscribers = new Set<() => void>();
+let estimatedBytes = 0;
+
+function translationKey(conversationId: string, messageId: string): string {
+  return JSON.stringify([conversationId, messageId]);
+}
+
+export type MaoyiTranslationRefreshStatus = Readonly<{
+  requestId: string;
+  conversationId: string;
+  messageId: string;
+  state: 'processing' | 'idle';
+  error?: 'failed' | 'timeout' | 'busy';
+}>;
+
+export function applyMaoyiTranslationRefreshStatus(
+  status: MaoyiTranslationRefreshStatus
+): void {
+  const key = translationKey(status.conversationId, status.messageId);
+  if (status.state === 'processing') {
+    if (refreshRequests.get(key) === status.requestId) return;
+    refreshRequests.set(key, status.requestId);
+    refreshErrors.delete(key);
+    const previousTimer = refreshTimers.get(key);
+    if (previousTimer) clearTimeout(previousTimer);
+    refreshTimers.set(key, setTimeout(() => {
+      if (refreshRequests.get(key) !== status.requestId) return;
+      refreshRequests.delete(key);
+      refreshTimers.delete(key);
+      refreshErrors.set(key, '翻译超时，请点击重试');
+      notifySubscribers();
+    }, 45_000));
+    notifySubscribers();
+    return;
+  }
+  if (refreshRequests.has(key) && refreshRequests.get(key) !== status.requestId) return;
+  if (status.error) {
+    refreshErrors.set(key, status.error === 'timeout' ? '翻译超时，请点击重试' : status.error === 'busy' ? '翻译繁忙，请点击重试' : '翻译失败，请点击重试');
+    while (refreshErrors.size > maoyiTranslationEntryLimit) refreshErrors.delete(refreshErrors.keys().next().value!);
+  } else {
+    refreshErrors.delete(key);
+  }
+  refreshRequests.delete(key);
+  const timer = refreshTimers.get(key);
+  if (timer) clearTimeout(timer);
+  refreshTimers.delete(key);
+  notifySubscribers();
+}
+
+function estimateTranslationBytes(result: MaoyiTranslationResult): number {
+  return (
+    128 +
+    (result.conversationId.length +
+      result.messageId.length +
+      result.sourceHash.length +
+      result.sourceText.length +
+      result.translatedText.length) *
+      2
+  );
+}
+
+function isBoundedIdentity(value: string): boolean {
+  return value.length > 0 && value.length <= maximumIdentityLength;
+}
+
+function normalizeTranslationResult(
+  result: MaoyiTranslationResult
+): StoredMaoyiTranslation | undefined {
+  if (
+    !isBoundedIdentity(result.conversationId) ||
+    !isBoundedIdentity(result.messageId) ||
+    !isBoundedIdentity(result.sourceHash) ||
+    result.sourceText !== normalizeMaoyiSourceText(result.sourceText) ||
+    legacyMaoyiSourceHash(result.sourceText) !== result.sourceHash
+  ) {
+    return undefined;
+  }
+
+  const translatedText = result.translatedText.trim();
+  if (
+    translatedText.length === 0 ||
+    translatedText.length > maximumTranslationLength
+  ) {
+    return undefined;
+  }
+
+  const normalized: MaoyiTranslationResult = {
+    conversationId: result.conversationId,
+    messageId: result.messageId,
+    sourceHash: result.sourceHash,
+    sourceText: result.sourceText,
+    translatedText,
+  };
+  return {
+    ...normalized,
+    estimatedBytes: estimateTranslationBytes(normalized),
+  };
+}
+
+function notifySubscribers(): void {
+  for (const subscriber of subscribers) {
+    try {
+      subscriber();
+    } catch {
+      // One React subscriber must not prevent the rest of a batch from rendering.
+    }
+  }
+}
+
+function touchTranslation(key: string): void {
+  const existing = translations.get(key);
+  if (!existing) {
+    return;
+  }
+  translations.delete(key);
+  translations.set(key, existing);
+}
+
+function trimTranslationCache(): boolean {
+  let changed = false;
+  while (
+    translations.size > maoyiTranslationEntryLimit ||
+    estimatedBytes > maoyiTranslationByteLimit
+  ) {
+    const oldest = translations.entries().next();
+    if (oldest.done) {
+      break;
+    }
+    const [key, value] = oldest.value;
+    translations.delete(key);
+    estimatedBytes = Math.max(0, estimatedBytes - value.estimatedBytes);
+    changed = true;
+  }
+  return changed;
+}
+
+export function applyMaoyiTranslationBatch(
+  results: ReadonlyArray<MaoyiTranslationResult>
+): number {
+  const changedKeys = new Set<string>();
+  let errorsCleared = false;
+
+  for (const result of results) {
+    const normalized = normalizeTranslationResult(result);
+    if (!normalized) {
+      continue;
+    }
+
+    const key = translationKey(normalized.conversationId, normalized.messageId);
+    if (refreshErrors.delete(key)) errorsCleared = true;
+    const existing = translations.get(key);
+    if (
+      existing &&
+      existing.sourceHash === normalized.sourceHash &&
+      existing.sourceText === normalized.sourceText &&
+      existing.translatedText === normalized.translatedText
+    ) {
+      touchTranslation(key);
+      continue;
+    }
+
+    if (existing) {
+      estimatedBytes = Math.max(0, estimatedBytes - existing.estimatedBytes);
+      translations.delete(key);
+    }
+    translations.set(key, normalized);
+    estimatedBytes += normalized.estimatedBytes;
+    changedKeys.add(key);
+  }
+
+  const evicted = trimTranslationCache();
+  if (changedKeys.size > 0 || evicted || errorsCleared) {
+    notifySubscribers();
+  }
+  return changedKeys.size;
+}
+
+function peekMaoyiTranslation(
+  projection: MaoyiMessageProjection | undefined
+): string | undefined {
+  if (!projection) {
+    return undefined;
+  }
+  const result = translations.get(
+    translationKey(projection.conversationId, projection.messageId)
+  );
+  return result && maoyiTranslationMatchesProjection(projection, result)
+    ? result.translatedText
+    : undefined;
+}
+
+export function getMaoyiTranslation(
+  projection: MaoyiMessageProjection | undefined
+): string | undefined {
+  const translatedText = peekMaoyiTranslation(projection);
+  if (projection && translatedText) {
+    touchTranslation(
+      translationKey(projection.conversationId, projection.messageId)
+    );
+  }
+  return translatedText;
+}
+
+export function subscribeToMaoyiTranslations(
+  subscriber: () => void
+): () => void {
+  subscribers.add(subscriber);
+  return () => {
+    subscribers.delete(subscriber);
+  };
+}
+
+export function useMaoyiTranslation(
+  projection: MaoyiMessageProjection | undefined
+): string | undefined {
+  const getSnapshot = useCallback(
+    () => peekMaoyiTranslation(projection),
+    [projection]
+  );
+  const translatedText = useSyncExternalStore(
+    subscribeToMaoyiTranslations,
+    getSnapshot,
+    getSnapshot
+  );
+
+  useEffect(() => {
+    if (projection && translatedText) {
+      touchTranslation(
+        translationKey(projection.conversationId, projection.messageId)
+      );
+    }
+  }, [projection, translatedText]);
+
+  return translatedText;
+}
+
+export function useMaoyiTranslationRefreshPending(
+  projection: MaoyiMessageProjection | undefined
+): boolean {
+  const getSnapshot = useCallback(
+    () => getMaoyiTranslationRefreshPending(projection),
+    [projection]
+  );
+  return useSyncExternalStore(
+    subscribeToMaoyiTranslations,
+    getSnapshot,
+    getSnapshot
+  );
+}
+
+export function getMaoyiTranslationRefreshPending(
+  projection: MaoyiMessageProjection | undefined
+): boolean {
+  return Boolean(
+    projection &&
+    refreshRequests.has(
+      translationKey(projection.conversationId, projection.messageId)
+    )
+  );
+}
+
+export function useMaoyiTranslationRefreshError(projection: MaoyiMessageProjection | undefined): string {
+  const getSnapshot = useCallback(() => projection ? refreshErrors.get(translationKey(projection.conversationId, projection.messageId)) || '' : '', [projection]);
+  return useSyncExternalStore(subscribeToMaoyiTranslations, getSnapshot, getSnapshot);
+}
+
+export function clearMaoyiTranslationRefreshRequests(): void {
+  for (const timer of refreshTimers.values()) clearTimeout(timer);
+  refreshTimers.clear();
+  if (!refreshRequests.size && !refreshErrors.size) return;
+  refreshRequests.clear();
+  refreshErrors.clear();
+  notifySubscribers();
+}
+
+export function clearMaoyiTranslationRuntime(): void {
+  if (translations.size === 0 && refreshRequests.size === 0 && refreshErrors.size === 0) {
+    return;
+  }
+  translations.clear();
+  clearMaoyiTranslationRefreshRequests();
+  estimatedBytes = 0;
+  notifySubscribers();
+}
+
+export function getMaoyiTranslationRuntimeStats(): TranslationRuntimeStats {
+  return {
+    entries: translations.size,
+    estimatedBytes,
+  };
+}
