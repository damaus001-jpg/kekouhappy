+        return undefined;
+      }
+      const trigger = parseVisibleMessage(value.trigger, value.conversationId);
+      if (!trigger || trigger.direction !== 'incoming') {
+        return undefined;
+      }
+      const projected = projectMaoyiMessage({
+        id: trigger.messageId,
+        conversationId: trigger.conversationId,
+        text: trigger.sourceText,
+        direction: trigger.direction,
+        timestamp: trigger.timestamp,
+      });
+      return projected &&
+        projected.sourceText === trigger.sourceText &&
+        projected.sourceHash === trigger.sourceHash
+        ? {
+            type: 'smartReply.error',
+            requestId: value.requestId,
+            contextVersion: maoyiSmartReplyContextVersion,
+            conversationId: value.conversationId,
+            trigger,
+            code: value.code,
+          }
+        : undefined;
+    }
+    case 'script.execute':
+      if (
+        hasOnlyKeys(value, ['type', 'requestId', 'script']) &&
+        isBoundedString(value.requestId, 160) &&
+        isBoundedString(value.script, 900 * 1024)
+      ) {
+        return {
+          type: 'script.execute',
+          requestId: value.requestId,
+          script: value.script,
+        };
+      }
+      return undefined;
