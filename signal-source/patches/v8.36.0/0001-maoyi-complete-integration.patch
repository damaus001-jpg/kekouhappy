+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import type { MaoyiTranslationResult } from './messageProjection.std.ts';
+import type { MaoyiMessageProjection } from './messageProjection.std.ts';
+import type { MaoyiSmartReplySuggestion } from './smartReplyContext.std.ts';
+import type { MaoyiSmartReplyErrorCode } from './smartReplyContext.std.ts';
+
+export const maoyiMessageEventChannel = 'maoyi:message-event';
+export const maoyiMessageCommandChannel = 'maoyi:message-command';
+
+export type MaoyiRendererCommand =
+  | Readonly<{
+      type: 'message.snapshot.request';
+      requestId: string;
+      resyncConversation?: boolean;
+      resetRefreshState?: boolean;
+    }>
+  | Readonly<{
+      type: 'translation.cacheResultBatch';
+      requestId: string;
+      conversationId: string;
+      results: ReadonlyArray<MaoyiTranslationResult>;
+    }>
+  | Readonly<{
+      type: 'translation.refresh.status';
+      requestId: string;
+      conversationId: string;
+      messageId: string;
+      state: 'processing' | 'idle';
+      error?: 'failed' | 'timeout' | 'busy';
+    }>
+  | Readonly<{
+      type: 'smartReply.result';
+      requestId: string;
+      contextVersion: 'df.signal.smart-reply-context.v1';
+      conversationId: string;
+      trigger: MaoyiMessageProjection;
+      replies: ReadonlyArray<MaoyiSmartReplySuggestion>;
+    }>
+  | Readonly<{
+      type: 'smartReply.error';
+      requestId: string;
+      contextVersion: 'df.signal.smart-reply-context.v1';
+      conversationId: string;
+      trigger: MaoyiMessageProjection;
+      code: MaoyiSmartReplyErrorCode;
+    }>
+  | Readonly<{ type: 'translation.runtime.clear' }>;
