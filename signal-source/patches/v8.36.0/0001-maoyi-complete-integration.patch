+        {
+          id: 'reply_2',
+          english: 'I like that idea',
+          chinese: '我喜欢这个想法',
+        },
+        { id: 'reply_3', english: 'Tell me more', chinese: '再多和我说说' },
+      ],
+    } as const;
+    const commandsBeforeSmartReply = window.webContents.commands.length;
+    control.emitCommand(smartReplyResult);
+    assert.equal(
+      window.webContents.commands.length,
+      commandsBeforeSmartReply + 1
+    );
+    assert.deepEqual(window.webContents.commands.at(-1), smartReplyResult);
+    control.emitCommand(smartReplyResult);
+    assert.equal(
+      window.webContents.commands.length,
+      commandsBeforeSmartReply + 1
+    );
+
+    const foreignEvent = {
+      sender: new FakeWebContents() as unknown as WebContents,
+    } as IpcMainInvokeEvent;
+    const commandCountBeforeForeignEvent = window.webContents.commands.length;
+    assert.equal(
+      ipc.handler(foreignEvent, {
+        type: 'conversation.changed',
+        conversationId,
+      }),
+      false
+    );
+    assert.equal(
+      window.webContents.commands.length,
+      commandCountBeforeForeignEvent
+    );
+
+    control.emitCommand({
+      type: 'message.snapshot.request',
+      requestId: secondRequestId,
+    });
+    assert.deepEqual(window.webContents.commands.at(-1), {
+      type: 'message.snapshot.request',
+      requestId: secondRequestId,
+      resyncConversation: true,
+    });
+    const otherConversationId = '44444444-4444-4444-8444-444444444444';
+    assert.equal(
+      ipc.handler(event, {
+        type: 'conversation.changed',
+        conversationId: otherConversationId,
+      }),
+      true
+    );
+    assert.equal(
+      ipc.handler(event, {
+        type: 'message.visibleBatch',
+        requestId: secondRequestId,
+        conversationId: otherConversationId,
+        messages: [],
+      }),
+      false
+    );
+
+    const commandsBeforeReload = window.webContents.commands.length;
+    window.webContents.emit('did-finish-load');
+    assert.equal(window.webContents.commands.length, commandsBeforeReload + 1);
+    assert.deepEqual(window.webContents.commands.at(-1), {
+      type: 'translation.runtime.clear',
+    });
+
+    exposable = true;
+    window.visible = false;
+    const commandsBeforeOrdinaryHide = window.webContents.commands.length;
+    window.emit('hide');
+    control.emitCommand({ type: 'window.hide' });
+    assert.equal(
+      window.webContents.commands.length,
+      commandsBeforeOrdinaryHide
+    );
+
+    window.visible = true;
+    control.emitCommand({ type: 'window.show' });
+    await new Promise(resolve => setTimeout(resolve, 0));
+    assert.equal(
+      (
+        window.webContents.commands.at(-1) as {
+          type?: string;
+        }
+      )?.type,
+      'message.snapshot.request'
+    );
+
+    exposable = false;
+    window.visible = false;
+    const commandsBeforeSecurityLock = window.webContents.commands.length;
+    control.emitCommand({
+      type: 'security.visibility',
+      locked: true,
+      revision: 1,
+    });
+    window.emit('hide');
+    control.emitCommand({ type: 'window.hide' });
+    assert.equal(
+      window.webContents.commands.length,
+      commandsBeforeSecurityLock
+    );
+    assert.equal(
+      ipc.handler(event, {
+        type: 'conversation.changed',
+        conversationId,
+      }),
+      false
+    );
+    assert.equal(
+      ipc.handler(event, { ...refreshEvent, requestId: secondRequestId }),
+      false
+    );
+
+    exposable = true;
+    window.visible = true;
+    control.emitCommand({ type: 'window.show' });
+    await new Promise(resolve => setTimeout(resolve, 0));
+    const localSnapshot = window.webContents.commands.at(-1);
+    assert.ok(
+      typeof localSnapshot === 'object' &&
+        localSnapshot != null &&
+        'type' in localSnapshot &&
+        localSnapshot.type === 'message.snapshot.request' &&
+        'requestId' in localSnapshot &&
+        typeof localSnapshot.requestId === 'string'
+    );
+    assert.match(
+      localSnapshot.requestId,
+      /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
+    );
+    assert.equal(
+      ipc.handler(event, {
+        type: 'conversation.changed',
+        conversationId: otherConversationId,
+      }),
+      true
+    );
+    assert.equal(
+      ipc.handler(event, {
+        type: 'message.visibleBatch',
+        requestId: localSnapshot.requestId,
+        conversationId: otherConversationId,
+        messages: [],
+      }),
+      true
+    );
+
+    const commandsBeforeTransportLoss = window.webContents.commands.length;
+    control.setAuthenticated(false);
+    assert.equal(
+      window.webContents.commands.length,
+      commandsBeforeTransportLoss + 1
+    );
+    assert.deepEqual(window.webContents.commands.at(-1), {
+      type: 'translation.runtime.clear',
+    });
+
+    bridge.stop();
+  });
+});
diff --git a/ts/test-node/maoyi/messageProjection_test.node.ts b/ts/test-node/maoyi/messageProjection_test.node.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2cd1f011cf1bf714965cb03b977ec8c955c58015
--- /dev/null
+++ b/ts/test-node/maoyi/messageProjection_test.node.ts
@@ -0,0 +1,207 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import assert from 'node:assert/strict';
+
+import {
+  maoyiMaximumSourceTextLength,
+  maoyiTranslationMatchesProjection,
+  legacyMaoyiSourceHash,
+  normalizeMaoyiSourceText,
+  projectMaoyiMessage,
+  type MaoyiMessageProjectionInput,
+} from '../../maoyi/messageProjection.std.ts';
+
+function message(
+  overrides: Partial<MaoyiMessageProjectionInput> = {}
+): MaoyiMessageProjectionInput {
+  return {
+    id: 'message-1',
+    conversationId: 'conversation-1',
+    text: 'Hello world',
+    direction: 'incoming',
+    timestamp: 1_800_000_000_000,
+    ...overrides,
+  };
+}
+
+describe('Maoyi message projection', () => {
+  it('normalizes and hashes exactly like the legacy renderer cache', () => {
+    assert.equal(
+      normalizeMaoyiSourceText('  Hello\n\tworld  '),
+      'Hello world'
+    );
+    assert.equal(legacyMaoyiSourceHash('  Hello\n\tworld  '), 'os091j');
+    assert.equal(legacyMaoyiSourceHash('Hello world'), 'os091j');
+  });
+
+  it('projects a stable identity for an ordinary English body', () => {
+    assert.deepEqual(projectMaoyiMessage(message()), {
+      conversationId: 'conversation-1',
+      messageId: 'message-1',
+      sourceHash: 'os091j',
+      sourceText: 'Hello world',
+      direction: 'incoming',
+      timestamp: 1_800_000_000_000,
+    });
+  });
+
+  it('adds English image and video captions to the existing text projection', () => {
+    const ordinaryText = projectMaoyiMessage(
+      message({ text: 'Ordinary message' })
+    );
+    assert.ok(ordinaryText);
+    assert.equal(ordinaryText.sourceText, 'Ordinary message');
+
+    const imageCaption = projectMaoyiMessage(
+      message({
+        text: 'Image caption',
+        attachments: [{ contentType: 'image/jpeg' }],
+      })
+    );
+    assert.ok(imageCaption);
+    assert.equal(imageCaption.sourceText, 'Image caption');
+    assert.equal(imageCaption.direction, 'incoming');
+
+    const videoCaption = projectMaoyiMessage(
+      message({
+        text: 'Video caption',
+        direction: 'outgoing',
+        attachments: [{ contentType: 'video/mp4' }],
+      })
+    );
+    assert.ok(videoCaption);
+    assert.equal(videoCaption.sourceText, 'Video caption');
+    assert.equal(videoCaption.direction, 'outgoing');
+
+    assert.equal(
+      projectMaoyiMessage(
+        message({
+          text: '',
+          attachments: [{ contentType: 'image/png' }],
+        })
+      ),
+      undefined
+    );
+  });
+
+  it('treats only a decoded empty contact list as no embedded contact', () => {
+    assert.deepEqual(
+      projectMaoyiMessage(message({ contact: [] })),
+      projectMaoyiMessage(message())
+    );
+    assert.equal(
+      projectMaoyiMessage(message({ contact: [{}] })),
+      undefined
+    );
+  });
+
+  it('projects only complete decoded Signal long-message bodies', () => {
+    const completeLongBody = `Long message ${'a'.repeat(2_100)}`;
+    const projection = projectMaoyiMessage(
+      message({
+        text: completeLongBody,
+        textAttachment: { contentType: 'text/x-signal-plain' },
+      })
+    );
+    assert.ok(projection);
+    assert.equal(projection.sourceText, completeLongBody);
+
+    assert.equal(
+      projectMaoyiMessage(
+        message({
+          text: 'a'.repeat(2_048),
+          textAttachment: { contentType: 'text/x-signal-plain' },
+        })
+      ),
+      undefined
+    );
+    assert.equal(
+      projectMaoyiMessage(
+        message({
+          text: completeLongBody,
+          textAttachment: { contentType: 'application/pdf' },
+        })
+      ),
+      undefined
+    );
+  });
+
+  it('excludes non-English, oversized, unsupported attachment, and special bubbles', () => {
+    assert.equal(projectMaoyiMessage(message({ text: '你好' })), undefined);
+    assert.equal(
+      projectMaoyiMessage(message({ text: 'Hello 你好' })),
+      undefined
+    );
+    assert.equal(
+      projectMaoyiMessage(
+        message({ text: `A${'b'.repeat(maoyiMaximumSourceTextLength)}` })
+      ),
+      undefined
+    );
+
+    const excluded: ReadonlyArray<Partial<MaoyiMessageProjectionInput>> = [
+      { attachments: [{}] },
+      { attachments: [{ contentType: 'audio/mpeg' }] },
+      { attachments: [{ contentType: 'application/pdf' }] },
+      {
+        attachments: [
+          { contentType: 'image/jpeg' },
+          { contentType: 'application/pdf' },
+        ],
+      },
+      {
+        attachments: [{ contentType: 'video/mp4' }],
+        isTapToView: true,
+      },
+      { textAttachment: {} },
+      { attachmentDroppedDueToSize: true },
+      { contact: {} },
+      { contact: [{}] },
+      { deletedForEveryone: true },
+      { giftBadge: {} },
+      { isSticker: true },
+      { isTapToView: true },
+      { payment: {} },
+      { poll: {} },
+      { storyReplyContext: {} },
+    ];
+    for (const payload of excluded) {
+      assert.equal(projectMaoyiMessage(message(payload)), undefined);
+    }
+  });
+
+  it('requires exact message, conversation, source text, and hash matches', () => {
+    const projection = projectMaoyiMessage(message());
+    assert.ok(projection);
+    const exact = {
+      conversationId: projection.conversationId,
+      messageId: projection.messageId,
+      sourceHash: projection.sourceHash,
+      sourceText: projection.sourceText,
+      translatedText: '你好，世界',
+    };
+    assert.equal(maoyiTranslationMatchesProjection(projection, exact), true);
+    assert.equal(
+      maoyiTranslationMatchesProjection(projection, {
+        ...exact,
+        sourceText: 'Hello  world',
+      }),
+      false
+    );
+    assert.equal(
+      maoyiTranslationMatchesProjection(projection, {
+        ...exact,
+        messageId: 'message-2',
+      }),
+      false
+    );
+    assert.equal(
+      maoyiTranslationMatchesProjection(projection, {
+        ...exact,
+        sourceHash: 'tampered',
+      }),
+      false
+    );
+  });
+});
