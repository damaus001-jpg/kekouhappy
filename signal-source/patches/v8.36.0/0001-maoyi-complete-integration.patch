+++ b/ts/maoyi/messageBridge.preload.ts
@@ -0,0 +1,954 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { randomUUID } from 'node:crypto';
+import { ipcRenderer, type IpcRendererEvent } from 'electron';
+
+import {
+  maoyiTranslationMatchesProjection,
+  legacyMaoyiSourceHash,
+  normalizeMaoyiSourceText,
+  type MaoyiMessageProjection,
+  type MaoyiTranslationResult,
+} from './messageProjection.std.ts';
+import {
+  applyMaoyiTranslationBatch,
+  applyMaoyiTranslationRefreshStatus,
+  clearMaoyiTranslationRuntime,
+  clearMaoyiTranslationRefreshRequests,
+} from './translationRuntime.preload.ts';
+import {
+  createMaoyiVisibleProjectionSignature,
+  createMaoyiVisibleMessageBatches,
+  maoyiVisibleBatchByteLimit,
+  maoyiVisibleBatchItemLimit,
+} from './messageBatching.std.ts';
+import {
+  maoyiMessageCommandChannel,
+  maoyiMessageEventChannel,
+  type MaoyiRendererCommand,
+} from './messageBridgeChannels.std.ts';
+import {
+  maoyiSmartReplyContextVersion,
+  isMaoyiSmartReplyTrigger,
+  selectMaoyiSmartReplyContext,
+  type MaoyiSmartReplySuggestion,
+  type MaoyiSmartReplyErrorCode,
+} from './smartReplyContext.std.ts';
+import {
+  applyMaoyiSmartReplyPending,
+  applyMaoyiSmartReplyResult,
+  clearMaoyiSmartReplyForTrigger,
+  clearMaoyiSmartReplyRuntime,
+} from './smartReplyRuntime.preload.ts';
+
+const rendererMessageBridgeKey = Symbol.for(
+  'maoyi.signal.renderer-message-bridge.v1'
+);
+const requestIdPattern =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+const sourceHashPattern = /^(?:0|[1-9a-z][0-9a-z]{0,6})$/;
+const pendingRequestLimit = 128;
+const pendingRequestTtlMs = 30_000;
+const pendingProjectionByteLimit = 15 * 1024 * 1024;
+const maximumTextBytes = 64 * 1024;
+const smartReplyMaximumTextBytes = 8 * 1024;
+
+type Snapshot = Readonly<{
+  conversationId: string;
+  messages: ReadonlyArray<MaoyiMessageProjection>;
+  smartReplyMessages?: ReadonlyArray<MaoyiMessageProjection>;
+}>;
+type SnapshotProvider = () => Snapshot | undefined;
+
+type PendingBatch = {
+  conversationId: string;
+  projections: ReadonlyMap<string, MaoyiMessageProjection>;
+  estimatedBytes: number;
+  expiresAt: number;
+};
+
+type MaoyiIpcRenderer = Readonly<{
+  invoke: (channel: string, value: unknown) => Promise<unknown>;
+  on: (
+    channel: string,
+    listener: (event: IpcRendererEvent, value: unknown) => void
+  ) => unknown;
+  off: (
+    channel: string,
+    listener: (event: IpcRendererEvent, value: unknown) => void
+  ) => unknown;
+}>;
+
+export type MaoyiRendererMessageBridge = Readonly<{
+  publishAddedMessage: (message: MaoyiMessageProjection) => Promise<void>;
+  requestTranslationRefresh: (
+    message: MaoyiMessageProjection
+  ) => Promise<void>;
+  requestSmartReply: (message: MaoyiMessageProjection) => Promise<void>;
+  publishVisibleMessages: (
+    conversationId: string,
+    messages: ReadonlyArray<MaoyiMessageProjection>
+  ) => Promise<void>;
+  setSnapshotProvider: (provider: SnapshotProvider) => () => void;
+  clear: () => void;
+  stop: () => void;
+}>;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value != null && !Array.isArray(value);
+}
+
+function hasOnlyKeys(
+  value: Record<string, unknown>,
+  allowed: ReadonlyArray<string>
+): boolean {
+  const keys = new Set(allowed);
+  return Object.keys(value).every(key => keys.has(key));
+}
+
+function isUuid(value: unknown): value is string {
+  return typeof value === 'string' && requestIdPattern.test(value);
+}
+
+function utf8Bytes(value: string): number {
+  return new TextEncoder().encode(value).byteLength;
+}
+
+function jsonBytes(value: unknown): number {
+  return utf8Bytes(JSON.stringify(value));
+}
+
+function isCanonicalProjection(
+  value: MaoyiMessageProjection
+): value is MaoyiMessageProjection {
+  return (
+    isUuid(value.conversationId) &&
+    isUuid(value.messageId) &&
+    sourceHashPattern.test(value.sourceHash) &&
+    value.sourceText === normalizeMaoyiSourceText(value.sourceText) &&
+    utf8Bytes(value.sourceText) > 0 &&
+    utf8Bytes(value.sourceText) <= maximumTextBytes &&
+    legacyMaoyiSourceHash(value.sourceText) === value.sourceHash &&
+    (value.direction === 'incoming' || value.direction === 'outgoing') &&
+    Number.isSafeInteger(value.timestamp) &&
+    value.timestamp >= 0
+  );
+}
+
+function projectionsExactlyMatch(
+  left: MaoyiMessageProjection,
+  right: MaoyiMessageProjection
+): boolean {
+  return (
+    left.conversationId === right.conversationId &&
+    left.messageId === right.messageId &&
+    left.sourceHash === right.sourceHash &&
+    left.sourceText === right.sourceText &&
+    left.direction === right.direction &&
+    left.timestamp === right.timestamp
+  );
+}
+
+function parseTranslationResult(
+  value: unknown,
+  conversationId: string
+): MaoyiTranslationResult | undefined {
+  if (
+    !isRecord(value) ||
+    !hasOnlyKeys(value, [
+      'conversationId',
+      'messageId',
+      'sourceHash',
+      'sourceText',
+      'translatedText',
+    ]) ||
+    value.conversationId !== conversationId ||
+    !isUuid(value.messageId) ||
+    typeof value.sourceHash !== 'string' ||
+    !sourceHashPattern.test(value.sourceHash) ||
+    typeof value.sourceText !== 'string' ||
+    value.sourceText.length === 0 ||
+    utf8Bytes(value.sourceText) > maximumTextBytes ||
+    typeof value.translatedText !== 'string' ||
+    value.translatedText.length === 0 ||
+    utf8Bytes(value.translatedText) > maximumTextBytes
+  ) {
+    return undefined;
+  }
+  return {
+    conversationId,
+    messageId: value.messageId,
+    sourceHash: value.sourceHash,
+    sourceText: value.sourceText,
+    translatedText: value.translatedText,
+  };
+}
+
+function parseCanonicalProjection(
+  value: unknown,
+  conversationId: string
+): MaoyiMessageProjection | undefined {
+  if (
+    !isRecord(value) ||
+    !hasOnlyKeys(value, [
+      'conversationId',
+      'messageId',
+      'sourceHash',
+      'sourceText',
+      'direction',
+      'timestamp',
+    ]) ||
+    value.conversationId !== conversationId ||
+    typeof value.messageId !== 'string' ||
+    typeof value.sourceHash !== 'string' ||
+    typeof value.sourceText !== 'string' ||
+    (value.direction !== 'incoming' && value.direction !== 'outgoing') ||
+    typeof value.timestamp !== 'number' ||
+    !Number.isSafeInteger(value.timestamp)
+  ) {
+    return undefined;
+  }
+  const projection: MaoyiMessageProjection = {
+    conversationId,
+    messageId: value.messageId,
+    sourceHash: value.sourceHash,
+    sourceText: value.sourceText,
+    direction: value.direction,
+    timestamp: value.timestamp,
+  };
+  return isCanonicalProjection(projection) ? projection : undefined;
+}
+
+function parseSmartReplySuggestions(
+  value: unknown
+): ReadonlyArray<MaoyiSmartReplySuggestion> | undefined {
+  const expectedIds = ['reply_1', 'reply_2', 'reply_3'] as const;
+  if (!Array.isArray(value) || value.length !== expectedIds.length) {
+    return undefined;
+  }
+  const replies: Array<MaoyiSmartReplySuggestion> = [];
+  for (let index = 0; index < expectedIds.length; index += 1) {
+    const reply = value[index];
+    const expectedId = expectedIds[index];
+    if (
+      !expectedId ||
+      !isRecord(reply) ||
+      !hasOnlyKeys(reply, ['id', 'english', 'chinese']) ||
+      reply.id !== expectedId ||
+      typeof reply.english !== 'string' ||
+      utf8Bytes(reply.english) === 0 ||
+      utf8Bytes(reply.english) > smartReplyMaximumTextBytes ||
+      !/[A-Za-z]/.test(reply.english) ||
+      /[\u3400-\u9fff]/u.test(reply.english) ||
+      typeof reply.chinese !== 'string' ||
+      utf8Bytes(reply.chinese) === 0 ||
+      utf8Bytes(reply.chinese) > smartReplyMaximumTextBytes
+    ) {
+      return undefined;
+    }
+    replies.push({
+      id: expectedId,
+      english: reply.english,
+      chinese: reply.chinese,
+    });
+  }
+  return replies;
+}
+
+function isSmartReplyErrorCode(
+  value: unknown
+): value is MaoyiSmartReplyErrorCode {
+  return (
+    value === 'unavailable' ||
+    value === 'rate-limited' ||
+    value === 'timeout' ||
+    value === 'invalid-response' ||
+    value === 'request-failed'
+  );
+}
+
+function parseRendererCommand(
+  value: unknown
+): MaoyiRendererCommand | undefined {
+  if (
+    !isRecord(value) ||
+    typeof value.type !== 'string' ||
+    jsonBytes(value) > maoyiVisibleBatchByteLimit
+  ) {
+    return undefined;
+  }
+  if (
+    value.type === 'translation.runtime.clear' &&
+    hasOnlyKeys(value, ['type'])
+  ) {
+    return { type: 'translation.runtime.clear' };
+  }
+  if (
+    value.type === 'message.snapshot.request' &&
+    hasOnlyKeys(value, ['type', 'requestId', 'resyncConversation', 'resetRefreshState']) &&
+    (value.resyncConversation === undefined || typeof value.resyncConversation === 'boolean') &&
+    (value.resetRefreshState === undefined || typeof value.resetRefreshState === 'boolean') &&
+    isUuid(value.requestId)
+  ) {
+    return {
+      type: 'message.snapshot.request',
+      requestId: value.requestId,
+      ...(value.resyncConversation ? { resyncConversation: true } : {}),
+      ...(value.resetRefreshState ? { resetRefreshState: true } : {}),
+    };
+  }
+  if (
+    value.type === 'translation.refresh.status' &&
+    hasOnlyKeys(value, [
+      'type',
+      'requestId',
+      'conversationId',
+      'messageId',
+      'state',
+      'error',
+    ]) &&
+    isUuid(value.requestId) &&
+    isUuid(value.conversationId) &&
+    isUuid(value.messageId) &&
+    (value.state === 'processing' || value.state === 'idle') &&
+    (value.error === undefined || value.error === 'failed' || value.error === 'timeout' || value.error === 'busy')
+  ) {
+    return {
+      type: 'translation.refresh.status',
+      requestId: value.requestId,
+      conversationId: value.conversationId,
+      messageId: value.messageId,
+      state: value.state,
+      ...(value.error ? { error: value.error } : {}),
+    };
+  }
+  if (
+    value.type === 'smartReply.result' &&
+    hasOnlyKeys(value, [
+      'type',
+      'requestId',
+      'contextVersion',
+      'conversationId',
+      'trigger',
+      'replies',
+    ]) &&
+    isUuid(value.requestId) &&
+    value.contextVersion === maoyiSmartReplyContextVersion &&
+    isUuid(value.conversationId)
+  ) {
+    const trigger = parseCanonicalProjection(
+      value.trigger,
+      value.conversationId
+    );
+    const replies = parseSmartReplySuggestions(value.replies);
+    if (trigger?.direction === 'incoming' && replies) {
+      return {
+        type: 'smartReply.result',
+        requestId: value.requestId,
+        contextVersion: maoyiSmartReplyContextVersion,
+        conversationId: value.conversationId,
+        trigger,
+        replies,
+      };
+    }
+    return undefined;
+  }
+  if (
+    value.type === 'smartReply.error' &&
+    hasOnlyKeys(value, [
+      'type',
+      'requestId',
+      'contextVersion',
+      'conversationId',
+      'trigger',
+      'code',
+    ]) &&
+    isUuid(value.requestId) &&
+    value.contextVersion === maoyiSmartReplyContextVersion &&
+    isUuid(value.conversationId) &&
+    isSmartReplyErrorCode(value.code)
+  ) {
+    const trigger = parseCanonicalProjection(
+      value.trigger,
+      value.conversationId
+    );
+    return trigger?.direction === 'incoming'
+      ? {
+          type: 'smartReply.error',
+          requestId: value.requestId,
+          contextVersion: maoyiSmartReplyContextVersion,
+          conversationId: value.conversationId,
+          trigger,
+          code: value.code,
+        }
+      : undefined;
+  }
+  if (
+    value.type !== 'translation.cacheResultBatch' ||
+    !hasOnlyKeys(value, ['type', 'requestId', 'conversationId', 'results']) ||
+    !isUuid(value.requestId) ||
+    !isUuid(value.conversationId) ||
+    !Array.isArray(value.results) ||
+    value.results.length > maoyiVisibleBatchItemLimit
+  ) {
+    return undefined;
+  }
+
+  const results: Array<MaoyiTranslationResult> = [];
+  const messageIds = new Set<string>();
+  for (const item of value.results) {
+    const parsed = parseTranslationResult(item, value.conversationId);
+    const normalizedMessageId = parsed?.messageId.toLowerCase();
+    if (
+      !parsed ||
+      !normalizedMessageId ||
+      messageIds.has(normalizedMessageId)
+    ) {
+      return undefined;
+    }
+    messageIds.add(normalizedMessageId);
+    results.push(parsed);
+  }
+  return {
+    type: 'translation.cacheResultBatch',
+    requestId: value.requestId,
+    conversationId: value.conversationId,
+    results,
+  };
+}
+
+export function createMaoyiRendererMessageBridge(
+  transport: MaoyiIpcRenderer = ipcRenderer
+): MaoyiRendererMessageBridge {
+  const pending = new Map<string, PendingBatch>();
+  const pendingSmartReplies = new Map<string, MaoyiMessageProjection>();
+  let pendingBytes = 0;
+  let announcedConversationId: string | undefined;
+  let activeProjectionSignature: string | undefined;
+  let snapshotProvider: SnapshotProvider | undefined;
+  let securityGeneration = 0;
+  let conversationEpoch = 0;
+  let normalPublishRevision = 0;
+  let queue: Promise<void> = Promise.resolve();
+  let stopped = false;
+
+  const removePending = (requestId: string): PendingBatch | undefined => {
+    const value = pending.get(requestId);
+    if (!value) {
+      return undefined;
+    }
+    pending.delete(requestId);
+    pendingBytes = Math.max(0, pendingBytes - value.estimatedBytes);
+    return value;
+  };
+
+  const prunePending = (): void => {
+    const now = Date.now();
+    for (const [requestId, value] of pending) {
+      if (value.expiresAt <= now) {
+        removePending(requestId);
+      }
+    }
+  };
+
+  const clearPending = (): void => {
+    pending.clear();
+    pendingBytes = 0;
+  };
+
+  const clearSmartReplyState = (): void => {
+    pendingSmartReplies.clear();
+    clearMaoyiSmartReplyRuntime();
+  };
+
+  const reservePending = (
+    requestId: string,
+    conversationId: string,
+    messages: ReadonlyArray<MaoyiMessageProjection>
+  ): boolean => {
+    prunePending();
+    if (pending.has(requestId)) {
+      return false;
+    }
+
+    const estimatedBytes = jsonBytes(messages);
+    if (estimatedBytes > pendingProjectionByteLimit) {
+      return false;
+    }
+    while (
+      pending.size >= pendingRequestLimit ||
+      pendingBytes + estimatedBytes > pendingProjectionByteLimit
+    ) {
+      const oldest = pending.keys().next();
+      if (oldest.done) {
+        return false;
+      }
+      removePending(oldest.value);
+    }
+
+    pending.set(requestId, {
+      conversationId,
+      projections: new Map(messages.map(item => [item.messageId, item])),
+      estimatedBytes,
+      expiresAt: Date.now() + pendingRequestTtlMs,
+    });
+    pendingBytes += estimatedBytes;
+    return true;
+  };
+
+  const sendEvent = async (value: unknown): Promise<boolean> => {
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+      return (
+        (await Promise.race([
+          transport.invoke(maoyiMessageEventChannel, value),
+          new Promise<boolean>(resolve => { timer = setTimeout(() => resolve(false), 8_000); }),
+        ])) === true
+      );
+    } catch {
+      return false;
+    } finally {
+      if (timer) clearTimeout(timer);
+    }
+  };
+
+  const runPublish = async (
+    snapshot: Snapshot,
+    generation: number,
+    forcedRequestId?: string,
+    revision?: number
+  ): Promise<void> => {
+    if (
+      stopped ||
+      generation !== securityGeneration ||
+      (revision != null && revision !== normalPublishRevision) ||
+      !isUuid(snapshot.conversationId)
+    ) {
+      return;
+    }
+
+    if (announcedConversationId !== snapshot.conversationId) {
+      clearPending();
+      clearSmartReplyState();
+      activeProjectionSignature = undefined;
+      if (
+        !(await sendEvent({
+          type: 'conversation.changed',
+          conversationId: snapshot.conversationId,
+        })) ||
+        stopped ||
+        generation !== securityGeneration ||
+        (revision != null && revision !== normalPublishRevision)
+      ) {
+        announcedConversationId = undefined;
+        return;
+      }
+      announcedConversationId = snapshot.conversationId;
+    }
+
+    const projectionSignature = createMaoyiVisibleProjectionSignature(
+      snapshot.conversationId,
+      snapshot.messages
+    );
+    if (activeProjectionSignature === projectionSignature && !forcedRequestId) {
+      return;
+    }
+    if (
+      activeProjectionSignature != null &&
+      activeProjectionSignature !== projectionSignature
+    ) {
+      clearPending();
+    }
+    activeProjectionSignature = projectionSignature;
+
+    const batches = createMaoyiVisibleMessageBatches(
+      snapshot.conversationId,
+      snapshot.messages
+    );
+    let allBatchesAccepted = true;
+    for (let index = 0; index < batches.length; index += 1) {
+      if (
+        stopped ||
+        generation !== securityGeneration ||
+        (revision != null && revision !== normalPublishRevision)
+      ) {
+        if (
+          generation === securityGeneration &&
+          activeProjectionSignature === projectionSignature
+        ) {
+          activeProjectionSignature = undefined;
+        }
+        return;
+      }
+      const messages = batches[index] ?? [];
+      const requestId =
+        index === 0 && forcedRequestId ? forcedRequestId : randomUUID();
+      if (!reservePending(requestId, snapshot.conversationId, messages)) {
+        allBatchesAccepted = false;
+        continue;
+      }
+      // Batches must preserve their visible-order request sequence.
+      // oxlint-disable-next-line no-await-in-loop
+      const accepted = await sendEvent({
+        type: 'message.visibleBatch',
+        requestId,
+        conversationId: snapshot.conversationId,
+        messages,
+      });
+      if (!accepted) {
+        allBatchesAccepted = false;
+        removePending(requestId);
+      }
+    }
+    if (
+      (!allBatchesAccepted ||
+        generation !== securityGeneration ||
+        (revision != null && revision !== normalPublishRevision)) &&
+      activeProjectionSignature === projectionSignature
+    ) {
+      activeProjectionSignature = undefined;
+    }
+  };
+
+  const enqueue = (work: () => Promise<void>): Promise<void> => {
+    // This is a deliberately serialized, bounded renderer publication queue.
+    // oxlint-disable-next-line promise/prefer-await-to-then, signal-desktop/no-then
+    const next = queue.then(work, work);
+    // oxlint-disable-next-line promise/prefer-await-to-then
+    queue = next.catch(() => undefined);
+    return next;
+  };
+
+  const handleResultBatch = async (
+    command: Extract<
+      MaoyiRendererCommand,
+      { type: 'translation.cacheResultBatch' }
+    >
+  ): Promise<void> => {
+    const expected = removePending(command.requestId);
+    let appliedCount = 0;
+    if (
+      expected &&
+      expected.conversationId === command.conversationId &&
+      command.results.every(result => {
+        const projection = expected.projections.get(result.messageId);
+        return Boolean(
+          projection && maoyiTranslationMatchesProjection(projection, result)
+        );
+      })
+    ) {
+      appliedCount = applyMaoyiTranslationBatch(command.results);
+    }
+    await sendEvent({
+      type: 'translation.cacheResultApplied',
+      requestId: command.requestId,
+      appliedCount,
+    });
+  };
+
+  const handleCommand = (_event: IpcRendererEvent, value: unknown): void => {
+    const command = parseRendererCommand(value);
+    if (!command) {
+      return;
+    }
+    if (command.type === 'translation.runtime.clear') {
+      securityGeneration += 1;
+      normalPublishRevision += 1;
+      announcedConversationId = undefined;
+      activeProjectionSignature = undefined;
+      clearPending();
+      clearMaoyiTranslationRuntime();
+      clearSmartReplyState();
+      return;
+    }
+    if (command.type === 'translation.refresh.status') {
+      applyMaoyiTranslationRefreshStatus(command);
+      return;
+    }
+    if (
+      command.type === 'smartReply.result' ||
+      command.type === 'smartReply.error'
+    ) {
+      const expected = pendingSmartReplies.get(command.requestId);
+      pendingSmartReplies.delete(command.requestId);
+      const snapshot = snapshotProvider?.();
+      const context = selectMaoyiSmartReplyContext(
+        command.conversationId,
+        snapshot?.smartReplyMessages ?? [],
+        command.trigger
+      );
+      if (
+        expected &&
+        announcedConversationId === command.conversationId &&
+        snapshot?.conversationId === command.conversationId &&
+        projectionsExactlyMatch(expected, command.trigger) &&
+        isMaoyiSmartReplyTrigger(command.trigger, context)
+      ) {
+        if (command.type === 'smartReply.result') {
+          applyMaoyiSmartReplyResult(command.trigger, command.replies);
+        } else {
+          clearMaoyiSmartReplyForTrigger(command.trigger);
+        }
+      }
+      return;
+    }
+    if (command.type === 'translation.cacheResultBatch') {
+      void handleResultBatch(command);
+      return;
+    }
+
+    const generation = securityGeneration;
+    void enqueue(async () => {
+      if (stopped || generation !== securityGeneration) {
+        return;
+      }
+      const snapshot = snapshotProvider?.();
+      if (!snapshot) {
+        return;
+      }
+      if (command.resyncConversation) {
+        announcedConversationId = undefined;
+        activeProjectionSignature = undefined;
+        clearPending();
+      }
+      if (command.resetRefreshState) clearMaoyiTranslationRefreshRequests();
+      const revision = normalPublishRevision;
+      await runPublish(snapshot, generation, command.requestId, revision);
+    });
+  };
+
+  transport.on(maoyiMessageCommandChannel, handleCommand);
+
+  return Object.freeze({
+    publishAddedMessage(message: MaoyiMessageProjection) {
+      const generation = securityGeneration;
+      const epoch = conversationEpoch;
+      return enqueue(async () => {
+        if (
+          stopped ||
+          generation !== securityGeneration ||
+          epoch !== conversationEpoch ||
+          !isCanonicalProjection(message)
+        ) {
+          return;
+        }
+        const snapshot = snapshotProvider?.();
+        const matches = snapshot?.messages.filter(
+          item =>
+            item.messageId.toLowerCase() === message.messageId.toLowerCase()
+        );
+        const [match] = matches ?? [];
+        if (
+          announcedConversationId !== message.conversationId ||
+          snapshot?.conversationId !== message.conversationId ||
+          matches?.length !== 1 ||
+          !match ||
+          !projectionsExactlyMatch(match, message)
+        ) {
+          return;
+        }
+        await sendEvent({ type: 'message.added', ...message });
+      });
+    },
+    requestTranslationRefresh(message: MaoyiMessageProjection) {
+      const generation = securityGeneration;
+      const epoch = conversationEpoch;
+      return enqueue(async () => {
+        if (
+          stopped ||
+          generation !== securityGeneration ||
+          epoch !== conversationEpoch ||
+          !isCanonicalProjection(message)
+        ) {
+          return;
+        }
+        const snapshot = snapshotProvider?.();
+        const matches = snapshot?.messages.filter(
+          item =>
+            item.messageId.toLowerCase() === message.messageId.toLowerCase()
+        );
+        const [match] = matches ?? [];
+        if (
+          announcedConversationId !== message.conversationId ||
+          snapshot?.conversationId !== message.conversationId ||
+          matches?.length !== 1 ||
+          !match ||
+          !projectionsExactlyMatch(match, message)
+        ) {
+          return;
+        }
+        await sendEvent({
+          type: 'translation.refresh.request',
+          requestId: randomUUID(),
+          ...message,
+        });
+      });
+    },
+    requestSmartReply(message: MaoyiMessageProjection) {
+      const generation = securityGeneration;
+      const epoch = conversationEpoch;
+      return enqueue(async () => {
+        if (
+          stopped ||
+          generation !== securityGeneration ||
+          epoch !== conversationEpoch ||
+          !isCanonicalProjection(message)
+        ) {
+          return;
+        }
+        const snapshot = snapshotProvider?.();
+        const context = selectMaoyiSmartReplyContext(
+          message.conversationId,
+          snapshot?.smartReplyMessages ?? [],
+          message
+        );
+        if (
+          announcedConversationId !== message.conversationId ||
+          snapshot?.conversationId !== message.conversationId ||
+          !isMaoyiSmartReplyTrigger(message, context)
+        ) {
+          return;
+        }
+        const requestId = randomUUID();
+        pendingSmartReplies.set(requestId, message);
+        applyMaoyiSmartReplyPending(message);
+        const accepted = await sendEvent({
+          type: 'smartReply.request',
+          requestId,
+          contextVersion: maoyiSmartReplyContextVersion,
+          conversationId: message.conversationId,
+          triggerMessageId: message.messageId,
+          messages: context,
+        });
+        if (!accepted) {
+          pendingSmartReplies.delete(requestId);
+          clearMaoyiSmartReplyForTrigger(message);
+        }
+      });
+    },
+    publishVisibleMessages(
+      conversationId: string,
+      messages: ReadonlyArray<MaoyiMessageProjection>
+    ) {
+      normalPublishRevision += 1;
+      const revision = normalPublishRevision;
+      const generation = securityGeneration;
+      return enqueue(() =>
+        runPublish(
+          { conversationId, messages },
+          generation,
+          undefined,
+          revision
+        )
+      );
+    },
+    setSnapshotProvider(provider: SnapshotProvider) {
+      conversationEpoch += 1;
+      announcedConversationId = undefined;
+      activeProjectionSignature = undefined;
+      clearPending();
+      snapshotProvider = provider;
+      return () => {
+        if (snapshotProvider === provider) {
+          conversationEpoch += 1;
+          snapshotProvider = undefined;
+          announcedConversationId = undefined;
+          activeProjectionSignature = undefined;
+          clearPending();
+        }
+      };
+    },
+    clear() {
+      securityGeneration += 1;
+      conversationEpoch += 1;
+      normalPublishRevision += 1;
+      announcedConversationId = undefined;
+      activeProjectionSignature = undefined;
+      clearPending();
+      clearMaoyiTranslationRuntime();
+      clearSmartReplyState();
+    },
+    stop() {
+      if (stopped) {
+        return;
+      }
+      stopped = true;
+      securityGeneration += 1;
+      conversationEpoch += 1;
+      normalPublishRevision += 1;
+      transport.off(maoyiMessageCommandChannel, handleCommand);
+      snapshotProvider = undefined;
+      announcedConversationId = undefined;
+      activeProjectionSignature = undefined;
+      clearPending();
+      clearMaoyiTranslationRuntime();
+      clearSmartReplyState();
+    },
+  });
+}
+
+export function startMaoyiRendererMessageBridge(): MaoyiRendererMessageBridge {
+  const existing = Reflect.get(globalThis, rendererMessageBridgeKey) as
+    | MaoyiRendererMessageBridge
+    | undefined;
+  if (existing) {
+    return existing;
+  }
+  const bridge = createMaoyiRendererMessageBridge();
+  Reflect.set(globalThis, rendererMessageBridgeKey, bridge);
+  return bridge;
+}
+
+function getRendererMessageBridge(): MaoyiRendererMessageBridge | undefined {
+  return Reflect.get(globalThis, rendererMessageBridgeKey) as
+    | MaoyiRendererMessageBridge
+    | undefined;
+}
+
+export function publishMaoyiVisibleMessages(
+  conversationId: string,
+  messages: ReadonlyArray<MaoyiMessageProjection>
+): Promise<void> {
+  return (
+    getRendererMessageBridge()?.publishVisibleMessages(
+      conversationId,
+      messages
+    ) ?? Promise.resolve()
+  );
+}
+
+export function publishMaoyiAddedMessage(
+  message: MaoyiMessageProjection
+): Promise<void> {
+  return (
+    getRendererMessageBridge()?.publishAddedMessage(message) ??
+    Promise.resolve()
+  );
+}
+
+export function requestMaoyiTranslationRefresh(
+  message: MaoyiMessageProjection
+): Promise<void> {
+  return (
+    getRendererMessageBridge()?.requestTranslationRefresh(message) ??
+    Promise.resolve()
+  );
+}
+
+export function requestMaoyiSmartReply(
+  message: MaoyiMessageProjection
+): Promise<void> {
+  return (
+    getRendererMessageBridge()?.requestSmartReply(message) ?? Promise.resolve()
+  );
+}
+
+export function setMaoyiSnapshotProvider(
+  provider: SnapshotProvider
+): () => void {
+  return (
+    getRendererMessageBridge()?.setSnapshotProvider(provider) ??
+    (() => undefined)
+  );
+}
