+    } as const;
+    assert.equal(ipc.handler(event, addedEvent), true);
+    assert.equal(ipc.handler(event, addedEvent), false);
+    assert.deepEqual(control.sent.at(-1), addedEvent);
+    const refreshEvent = {
+      type: 'translation.refresh.request',
+      requestId,
+      conversationId,
+      messageId,
+      sourceHash: legacyMaoyiSourceHash('hello'),
+      sourceText: 'hello',
+      direction: 'incoming',
+      timestamp: 1_800_000_000_000,
+    } as const;
+    assert.equal(ipc.handler(event, refreshEvent), true);
+    assert.deepEqual(control.sent.at(-1), refreshEvent);
+    assert.equal(ipc.handler(event, refreshEvent), false);
+    const smartReplyEvent = {
+      type: 'smartReply.request',
+      requestId,
+      contextVersion: 'df.signal.smart-reply-context.v1',
+      conversationId,
+      triggerMessageId: messageId,
+      messages: [
+        {
+          conversationId,
+          messageId: 'aaaaaaaa-aaaa-7aaa-8aaa-aaaaaaaaaaaa',
+          sourceHash: legacyMaoyiSourceHash('Earlier reply'),
+          sourceText: 'Earlier reply',
+          direction: 'outgoing',
+          timestamp: 1_799_999_999_999,
+        },
+        {
+          conversationId,
+          messageId,
+          sourceHash: legacyMaoyiSourceHash('hello'),
+          sourceText: 'hello',
+          direction: 'incoming',
+          timestamp: 1_800_000_000_000,
+        },
+      ],
+    } as const;
+    assert.equal(ipc.handler(event, smartReplyEvent), true);
+    assert.deepEqual(control.sent.at(-1), smartReplyEvent);
+    assert.equal(ipc.handler(event, smartReplyEvent), false);
+    assert.equal(
+      ipc.handler(event, {
+        ...refreshEvent,
+        requestId: secondRequestId,
+        conversationId: '44444444-4444-4444-8444-444444444444',
+      }),
+      false
+    );
+    assert.equal(
+      ipc.handler(event, {
+        ...smartReplyEvent,
+        requestId: secondRequestId,
+        conversationId: '44444444-4444-4444-8444-444444444444',
+      }),
+      false
+    );
+    assert.equal(
+      ipc.handler(event, {
+        ...addedEvent,
+        conversationId: '44444444-4444-4444-8444-444444444444',
+      }),
+      false
+    );
+    assert.equal(
+      ipc.handler(event, {
+        type: 'message.visibleBatch',
+        requestId,
+        conversationId,
+        messages: [
+          {
+            conversationId,
+            messageId,
+            sourceHash: '1abc23',
+            sourceText: 'hello',
+            direction: 'incoming',
+            timestamp: 1_800_000_000_000,
