+        id: trigger.messageId,
+        conversationId: trigger.conversationId,
+        text: trigger.sourceText,
+        direction: trigger.direction,
+        timestamp: trigger.timestamp,
+      });
+      return projected &&
+        projected.sourceText === trigger.sourceText &&
+        projected.sourceHash === trigger.sourceHash
+        ? {
+            type: 'smartReply.result',
+            requestId: value.requestId,
+            contextVersion: maoyiSmartReplyContextVersion,
+            conversationId: value.conversationId,
+            trigger,
+            replies,
+          }
+        : undefined;
+    }
+    case 'smartReply.error': {
+      if (
+        !isMaoyiControlBusinessPayloadWithinLimit(value) ||
+        !hasOnlyKeys(value, [
+          'type',
+          'requestId',
+          'contextVersion',
+          'conversationId',
+          'trigger',
+          'code',
+        ]) ||
+        !isMaoyiControlUuid(value.requestId) ||
+        value.contextVersion !== maoyiSmartReplyContextVersion ||
+        !isMaoyiControlUuid(value.conversationId) ||
+        !isSmartReplyErrorCode(value.code)
