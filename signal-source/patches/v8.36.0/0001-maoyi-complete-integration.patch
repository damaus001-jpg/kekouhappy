@@ -0,0 +1,101 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import type { UnknownAction } from 'redux';
+
+import type { StateType } from '../state/reducer.preload.ts';
+import { getSelectedConversationId } from '../state/selectors/nav.std.ts';
+import type { MaoyiMessageProjection } from './messageProjection.std.ts';
+import { projectMaoyiVisibleMessages } from './visibleMessageProjection.std.ts';
+
+type ParsedMessagesAddedAction = Readonly<{
+  conversationId: string;
+  isActive: boolean;
+  messageId: string;
+}>;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value != null && !Array.isArray(value);
+}
+
+function hasOnlyKeys(
+  value: Record<string, unknown>,
+  allowed: ReadonlyArray<string>
+): boolean {
+  const allowedKeys = new Set(allowed);
+  return Object.keys(value).every(key => allowedKeys.has(key));
+}
+
+function parseMessagesAddedAction(
+  action: UnknownAction
+): ParsedMessagesAddedAction | undefined {
+  if (action.type !== 'MESSAGES_ADDED' || !isRecord(action.payload)) {
+    return undefined;
+  }
+  const payload = action.payload;
+  if (
+    !hasOnlyKeys(payload, [
+      'conversationId',
+      'isActive',
+      'isJustSent',
+      'isNewMessage',
+      'messages',
+    ]) ||
+    typeof payload.conversationId !== 'string' ||
+    typeof payload.isActive !== 'boolean' ||
+    typeof payload.isJustSent !== 'boolean' ||
+    payload.isNewMessage !== true ||
+    !Array.isArray(payload.messages) ||
+    payload.messages.length !== 1
+  ) {
+    return undefined;
+  }
+
+  const [message] = payload.messages;
+  if (
+    !isRecord(message) ||
+    typeof message.id !== 'string' ||
+    message.conversationId !== payload.conversationId
+  ) {
+    return undefined;
+  }
+
+  return {
+    conversationId: payload.conversationId,
+    isActive: payload.isActive,
+    messageId: message.id,
+  };
+}
+
+export function projectMaoyiAddedMessageFromAction(
+  beforeState: StateType,
+  action: UnknownAction,
+  afterState: StateType
+): MaoyiMessageProjection | undefined {
+  const parsed = parseMessagesAddedAction(action);
+  if (!parsed) {
+    return undefined;
+  }
+
+  const { conversationId, messageId } = parsed;
+  if (
+    getSelectedConversationId(beforeState) !== conversationId ||
+    getSelectedConversationId(afterState) !== conversationId ||
+    beforeState.conversations.messagesLookup[messageId] != null
+  ) {
+    return undefined;
+  }
+
+  const conversation =
+    afterState.conversations.messagesByConversation[conversationId];
+  if (!conversation?.messageIds.includes(messageId)) {
+    return undefined;
+  }
+
+  const projections = projectMaoyiVisibleMessages(
+    conversationId,
+    [messageId],
+    afterState.conversations.messagesLookup
+  );
+  return projections.length === 1 ? projections[0] : undefined;
+}
diff --git a/ts/maoyi/messageBatching.std.ts b/ts/maoyi/messageBatching.std.ts
new file mode 100644
index 0000000000000000000000000000000000000000..473b4b7698357d9a9b4909c5b8f827c6aad1a8d3
--- /dev/null
+++ b/ts/maoyi/messageBatching.std.ts
@@ -0,0 +1,97 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import type { MaoyiMessageProjection } from './messageProjection.std.ts';
+
+export const maoyiVisibleBatchItemLimit = 100;
+export const maoyiVisibleBatchByteLimit = 768 * 1024;
+
+const requestIdBytePlaceholder = '00000000-0000-4000-8000-000000000000';
+
+function byteLength(value: unknown): number {
+  return new TextEncoder().encode(JSON.stringify(value)).byteLength;
+}
+
+export function createMaoyiVisibleProjectionSignature(
+  conversationId: string,
+  messages: ReadonlyArray<MaoyiMessageProjection>
+): string {
+  const messageIds = new Set<string>();
+  const identities: Array<ReadonlyArray<string>> = [];
+  for (const message of messages) {
+    const messageId = message.messageId.toLowerCase();
+    if (
+      message.conversationId !== conversationId ||
+      messageIds.has(messageId)
+    ) {
+      continue;
+    }
+    messageIds.add(messageId);
+    identities.push([messageId, message.sourceHash, message.sourceText]);
+  }
+  return JSON.stringify([conversationId, identities]);
+}
+
+export function maoyiVisibleBatchJsonBytes(
+  conversationId: string,
+  messages: ReadonlyArray<MaoyiMessageProjection>,
+  requestId = requestIdBytePlaceholder
+): number {
+  return byteLength({
+    type: 'message.visibleBatch',
+    requestId,
+    conversationId,
+    messages,
+  });
+}
+
+export function createMaoyiVisibleMessageBatches(
+  conversationId: string,
+  messages: ReadonlyArray<MaoyiMessageProjection>,
+  jsonByteLength: (value: unknown) => number = byteLength
+): Array<Array<MaoyiMessageProjection>> {
+  const batches: Array<Array<MaoyiMessageProjection>> = [];
+  let current: Array<MaoyiMessageProjection> = [];
+  const emptyBatchBytes = jsonByteLength({
+    type: 'message.visibleBatch',
+    requestId: requestIdBytePlaceholder,
+    conversationId,
+    messages: [],
+  });
+  let currentBytes = emptyBatchBytes;
+  const messageIds = new Set<string>();
+
+  for (const message of messages) {
+    const normalizedMessageId = message.messageId.toLowerCase();
+    if (
+      message.conversationId !== conversationId ||
+      messageIds.has(normalizedMessageId)
+    ) {
+      continue;
+    }
+    const messageBytes = jsonByteLength(message);
+    if (emptyBatchBytes + messageBytes > maoyiVisibleBatchByteLimit) {
+      continue;
+    }
+    const separatorBytes = current.length > 0 ? 1 : 0;
+    if (
+      current.length > 0 &&
+      (current.length >= maoyiVisibleBatchItemLimit ||
+        currentBytes + separatorBytes + messageBytes >
+          maoyiVisibleBatchByteLimit)
+    ) {
+      batches.push(current);
+      current = [];
+      currentBytes = emptyBatchBytes;
+    }
+
+    messageIds.add(normalizedMessageId);
+    currentBytes += (current.length > 0 ? 1 : 0) + messageBytes;
+    current.push(message);
+  }
+
+  if (current.length > 0 || batches.length === 0) {
+    batches.push(current);
+  }
+  return batches;
+}
diff --git a/ts/maoyi/messageBridge.preload.ts b/ts/maoyi/messageBridge.preload.ts
