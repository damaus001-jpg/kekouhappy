+      type: 'translation.cacheResultApplied';
+      requestId: string;
+      appliedCount: number;
+    }>
+  | Readonly<{ type: 'script.result'; requestId: string; result: unknown }>
+  | Readonly<{
+      type: 'error';
+      requestId?: string;
+      message: string;
+      visible?: boolean;
+      bounds?: MaoyiWindowBounds;
