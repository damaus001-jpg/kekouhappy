+function parseVisibleMessage(
+  value: unknown,
+  expectedConversationId: string
+): MaoyiVisibleMessage | undefined {
+  if (
+    !isRecord(value) ||
+    !hasOnlyKeys(value, [
+      'conversationId',
+      'messageId',
+      'sourceHash',
+      'sourceText',
+      'direction',
+      'timestamp',
+    ]) ||
+    value.conversationId !== expectedConversationId ||
+    !isMaoyiControlUuid(value.conversationId) ||
+    !isMaoyiControlUuid(value.messageId) ||
+    !isMaoyiControlSourceHash(value.sourceHash) ||
+    !isMaoyiControlText(value.sourceText) ||
+    (value.direction !== 'incoming' && value.direction !== 'outgoing') ||
+    !isFiniteIntegerInRange(value.timestamp, 0, Number.MAX_SAFE_INTEGER)
+  ) {
+    return undefined;
+  }
+  return {
+    conversationId: value.conversationId,
+    messageId: value.messageId,
+    sourceHash: value.sourceHash,
+    sourceText: value.sourceText,
+    direction: value.direction,
+    timestamp: value.timestamp,
+  };
+}
+
+function parseTranslationCacheResult(
+  value: unknown,
+  expectedConversationId: string
+): MaoyiTranslationCacheResult | undefined {
+  if (
+    !isRecord(value) ||
+    !hasOnlyKeys(value, [
+      'conversationId',
+      'messageId',
+      'sourceHash',
+      'sourceText',
+      'translatedText',
+    ]) ||
+    value.conversationId !== expectedConversationId ||
+    !isMaoyiControlUuid(value.conversationId) ||
+    !isMaoyiControlUuid(value.messageId) ||
+    !isMaoyiControlSourceHash(value.sourceHash) ||
+    !isMaoyiControlText(value.sourceText) ||
+    !isMaoyiControlText(value.translatedText)
+  ) {
+    return undefined;
+  }
+  return {
+    conversationId: value.conversationId,
+    messageId: value.messageId,
+    sourceHash: value.sourceHash,
+    sourceText: value.sourceText,
+    translatedText: value.translatedText,
+  };
+}
+
+function parseSmartReplySuggestions(
+  value: unknown
+): ReadonlyArray<MaoyiSmartReplySuggestion> | undefined {
+  const expectedIds = ['reply_1', 'reply_2', 'reply_3'] as const;
+  if (!Array.isArray(value) || value.length !== expectedIds.length) {
+    return undefined;
+  }
+  const replies: Array<MaoyiSmartReplySuggestion> = [];
+  for (let index = 0; index < expectedIds.length; index += 1) {
+    const reply = value[index];
+    const expectedId = expectedIds[index];
+    if (
+      !expectedId ||
+      !isRecord(reply) ||
+      !hasOnlyKeys(reply, ['id', 'english', 'chinese']) ||
+      reply.id !== expectedId ||
+      !isBoundedString(reply.english, maoyiSmartReplyMaxTextBytes) ||
+      reply.english.length === 0 ||
+      !/[A-Za-z]/.test(reply.english) ||
+      /[\u3400-\u9fff]/u.test(reply.english) ||
+      !isBoundedString(reply.chinese, maoyiSmartReplyMaxTextBytes) ||
+      reply.chinese.length === 0
+    ) {
+      return undefined;
+    }
+    replies.push({
+      id: expectedId,
+      english: reply.english,
+      chinese: reply.chinese,
+    });
+  }
+  return replies;
+}
+
+function isSmartReplyErrorCode(
+  value: unknown
+): value is MaoyiSmartReplyErrorCode {
+  return (
+    value === 'unavailable' ||
+    value === 'rate-limited' ||
+    value === 'timeout' ||
+    value === 'invalid-response' ||
+    value === 'request-failed'
+  );
+}
+
+function parseStrictBatch<T>(
+  value: unknown,
+  parseItem: (item: unknown) => T | undefined,
+  itemIdentity: (item: T) => string
+): ReadonlyArray<T> | undefined {
+  if (!Array.isArray(value) || value.length > maoyiControlMaxBatchItems) {
+    return undefined;
+  }
+  const parsed: Array<T> = [];
+  const identities = new Set<string>();
+  for (const item of value) {
+    const parsedItem = parseItem(item);
+    if (!parsedItem) {
+      return undefined;
+    }
+    const identity = itemIdentity(parsedItem);
+    if (identities.has(identity)) {
+      return undefined;
+    }
+    identities.add(identity);
+    parsed.push(parsedItem);
+  }
+  return parsed;
+}
+
+export function parseMaoyiControlCommand(
+  value: unknown
+): MaoyiControlCommand | undefined {
+  if (!isRecord(value) || typeof value.type !== 'string') {
+    return undefined;
+  }
