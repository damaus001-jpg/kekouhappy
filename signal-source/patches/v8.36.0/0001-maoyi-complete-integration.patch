diff --git a/ts/maoyi/messageAddedObserver.std.ts b/ts/maoyi/messageAddedObserver.std.ts
new file mode 100644
index 0000000000000000000000000000000000000000..db971faf821c69191f6a4cc4eef4d495d96e2559
