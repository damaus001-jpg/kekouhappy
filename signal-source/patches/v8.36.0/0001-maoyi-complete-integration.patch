+      return undefined;
+    case 'smartReply.result': {
+      if (
+        !isMaoyiControlBusinessPayloadWithinLimit(value) ||
+        !hasOnlyKeys(value, [
+          'type',
+          'requestId',
+          'contextVersion',
+          'conversationId',
+          'trigger',
+          'replies',
+        ]) ||
+        !isMaoyiControlUuid(value.requestId) ||
