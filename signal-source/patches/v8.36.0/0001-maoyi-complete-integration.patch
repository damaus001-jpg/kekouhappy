+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import type { BrowserWindow, IpcMainInvokeEvent, WebContents } from 'electron';
+
+import type { MaoyiControlBridge } from '../../../app/maoyi/controlBridge.main.ts';
+import type {
+  MaoyiControlCommand,
+  MaoyiControlEvent,
+} from '../../../app/maoyi/controlProtocol.node.ts';
+import {
+  MaoyiAddedMessageLedger,
+  MaoyiRequestLedger,
+  startMaoyiMessageBridge,
+} from '../../../app/maoyi/messageBridge.main.ts';
+import type { MaoyiWindowController } from '../../../app/maoyi/windowController.main.ts';
+import {
+  maoyiMessageCommandChannel,
+  maoyiMessageEventChannel,
+} from '../../maoyi/messageBridgeChannels.std.ts';
+import { legacyMaoyiSourceHash } from '../../maoyi/messageProjection.std.ts';
+
+const conversationId = '22222222-2222-4222-8222-222222222222';
+const messageId = '33333333-3333-4333-8333-333333333333';
+const requestId = '11111111-1111-4111-8111-111111111111';
+const secondRequestId = '55555555-5555-4555-8555-555555555555';
+
+class FakeWebContents extends EventEmitter {
+  public destroyed = false;
+  public readonly commands: Array<unknown> = [];
+
+  public isDestroyed(): boolean {
+    return this.destroyed;
+  }
+
+  public send(channel: string, command: unknown): void {
+    assert.equal(channel, maoyiMessageCommandChannel);
+    this.commands.push(command);
+  }
+}
+
+// oxlint-disable-next-line max-classes-per-file
+class FakeWindow extends EventEmitter {
+  public destroyed = false;
+  public visible = true;
+  public readonly webContents = new FakeWebContents();
+
+  public isDestroyed(): boolean {
+    return this.destroyed;
+  }
+
+  public isVisible(): boolean {
+    return this.visible;
+  }
+}
+
+class FakeIpcMain {
+  public handler:
+    | ((event: IpcMainInvokeEvent, value: unknown) => boolean)
+    | undefined;
+
+  public handle(
+    channel: string,
+    handler: (event: IpcMainInvokeEvent, value: unknown) => boolean
+  ): void {
+    assert.equal(channel, maoyiMessageEventChannel);
+    this.handler = handler;
+  }
+
+  public removeHandler(channel: string): void {
+    assert.equal(channel, maoyiMessageEventChannel);
+    this.handler = undefined;
+  }
+}
+
+class FakeControlBridge {
+  public authenticated = true;
+  public readonly sent: Array<MaoyiControlEvent> = [];
+  readonly #commandHandlers = new Set<
+    (command: MaoyiControlCommand) => void
+  >();
+  readonly #transportHandlers = new Set<(authenticated: boolean) => void>();
+
+  public onCommand(
+    handler: (command: MaoyiControlCommand) => void
+  ): () => void {
+    this.#commandHandlers.add(handler);
+    return () => this.#commandHandlers.delete(handler);
+  }
+
+  public onTransportState(
+    handler: (authenticated: boolean) => void
+  ): () => void {
+    this.#transportHandlers.add(handler);
+    handler(this.authenticated);
+    return () => this.#transportHandlers.delete(handler);
+  }
+
+  public send(event: MaoyiControlEvent): boolean {
+    if (!this.authenticated) {
+      return false;
+    }
+    this.sent.push(event);
+    return true;
+  }
+
+  public emitCommand(command: MaoyiControlCommand): void {
+    for (const handler of this.#commandHandlers) {
+      handler(command);
+    }
+  }
+
+  public setAuthenticated(authenticated: boolean): void {
+    this.authenticated = authenticated;
+    for (const handler of this.#transportHandlers) {
+      handler(authenticated);
+    }
+  }
+}
+
+describe('Maoyi main message bridge', () => {
+  it('bounds and expires message-added identities without retaining bodies', () => {
+    let now = 1_000;
+    const ledger = new MaoyiAddedMessageLedger(() => now, 2, 100);
+
+    assert.equal(ledger.accept(messageId), true);
+    assert.equal(ledger.accept(messageId.toUpperCase()), false);
+    assert.equal(ledger.accept(requestId), true);
+    assert.equal(ledger.accept(secondRequestId), true);
+    assert.equal(ledger.accept(messageId), true);
+
+    now += 101;
+    assert.equal(ledger.accept(messageId), true);
+    ledger.clear();
+    assert.equal(ledger.accept(messageId), true);
+  });
+
+  it('bounds request IDs and rejects stale, replayed, and cross-conversation transitions', () => {
+    let now = 1_000;
+    const ledger = new MaoyiRequestLedger(() => now, 2, 100);
+    const otherConversationId = '44444444-4444-4444-8444-444444444444';
+
+    assert.equal(ledger.beginSnapshot(requestId), true);
+    assert.equal(ledger.beginSnapshot(requestId), false);
+    assert.equal(ledger.beginVisible(requestId, conversationId), true);
+    assert.equal(ledger.acceptResult(requestId, otherConversationId), false);
+    assert.equal(ledger.acceptResult(requestId, conversationId), true);
+    assert.equal(ledger.acceptResult(requestId, conversationId), false);
+    assert.equal(ledger.acceptAck(requestId), true);
+    assert.equal(ledger.acceptAck(requestId), false);
+    assert.equal(ledger.beginVisible(requestId, conversationId), false);
+
+    now += 101;
+    assert.equal(ledger.beginVisible(requestId, conversationId), true);
+
+    const oneShotLedger = new MaoyiRequestLedger(() => now, 2, 100);
+    assert.equal(oneShotLedger.beginSnapshot(secondRequestId, true), true);
+    oneShotLedger.invalidateForConversationChange();
+    oneShotLedger.invalidateForConversationChange();
+    assert.equal(
+      oneShotLedger.beginVisible(secondRequestId, conversationId),
+      false
+    );
+  });
+
+  it('accepts only the attached visible main renderer and forwards each result once', async () => {
+    const control = new FakeControlBridge();
+    const ipc = new FakeIpcMain();
+    let exposable = true;
+    const controller = {
+      canExposeWindows: () => exposable,
+    } as MaoyiWindowController;
+    const bridge = startMaoyiMessageBridge(
+      control as unknown as MaoyiControlBridge,
+      controller,
+      ipc as never
+    );
+    const window = new FakeWindow();
+    bridge.attachMainWindow(window as unknown as BrowserWindow);
+    window.webContents.commands.length = 0;
+    assert.ok(ipc.handler);
+    const event = {
