+++ b/ts/test-node/maoyi/refreshState_test.node.ts
@@ -0,0 +1,120 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import assert from 'node:assert/strict';
+
+import { parseMaoyiControlCommand } from '../../../app/maoyi/controlProtocol.node.ts';
+import { MaoyiTranslationRefreshLedger } from '../../../app/maoyi/messageBridge.main.ts';
+import {
+  applyMaoyiTranslationRefreshStatus,
+  clearMaoyiTranslationRuntime,
+  getMaoyiTranslationRefreshPending,
+} from '../../maoyi/translationRuntime.preload.ts';
+import { legacyMaoyiSourceHash } from '../../maoyi/messageProjection.std.ts';
+
+describe('Maoyi real translation refresh state', () => {
+  const requestId = '11111111-1111-4111-8111-111111111111';
+  const nextRequestId = '55555555-5555-4555-8555-555555555555';
+  const conversationId = '22222222-2222-4222-8222-222222222222';
+  const messageId = '33333333-3333-4333-8333-333333333333';
+  const projection = {
+    conversationId,
+    messageId,
+    sourceHash: legacyMaoyiSourceHash('hello'),
+    sourceText: 'hello',
+    direction: 'incoming' as const,
+    timestamp: 1_800_000_000_000,
+  };
+
+  afterEach(() => {
+    clearMaoyiTranslationRuntime();
+  });
+
+  it('parses only the strict authenticated status shape', () => {
+    const status = {
+      type: 'translation.refresh.status',
+      requestId,
+      conversationId,
+      messageId,
+      state: 'processing',
+    } as const;
+    assert.deepEqual(parseMaoyiControlCommand(status), status);
+    assert.equal(
+      parseMaoyiControlCommand({ ...status, sourceText: 'must not cross' }),
+      undefined
+    );
+    assert.equal(
+      parseMaoyiControlCommand({ ...status, state: 'queued' }),
+      undefined
+    );
+  });
+
+  it('correlates status with the exact renderer refresh request', () => {
+    const ledger = new MaoyiTranslationRefreshLedger();
+    const request = {
+      type: 'translation.refresh.request',
+      requestId,
+      ...projection,
+    } as const;
+    assert.equal(ledger.begin(request), true);
+    assert.equal(
+      ledger.acceptStatus({
+        type: 'translation.refresh.status',
+        requestId,
+        conversationId,
+        messageId,
+        state: 'processing',
+      }),
+      true
+    );
+    assert.equal(
+      ledger.acceptStatus({
+        type: 'translation.refresh.status',
+        requestId,
+        conversationId,
+        messageId: nextRequestId,
+        state: 'idle',
+      }),
+      false
+    );
+    assert.equal(
+      ledger.acceptStatus({
+        type: 'translation.refresh.status',
+        requestId,
+        conversationId,
+        messageId,
+        state: 'idle',
+      }),
+      true
+    );
+  });
+
+  it('does not let an older completion clear a newer request', () => {
+    applyMaoyiTranslationRefreshStatus({
+      requestId,
+      conversationId,
+      messageId,
+      state: 'processing',
+    });
+    applyMaoyiTranslationRefreshStatus({
+      requestId: nextRequestId,
+      conversationId,
+      messageId,
+      state: 'processing',
+    });
+    applyMaoyiTranslationRefreshStatus({
+      requestId,
+      conversationId,
+      messageId,
+      state: 'idle',
+    });
+    assert.equal(getMaoyiTranslationRefreshPending(projection), true);
+    applyMaoyiTranslationRefreshStatus({
+      requestId: nextRequestId,
+      conversationId,
+      messageId,
+      state: 'idle',
+    });
+    assert.equal(getMaoyiTranslationRefreshPending(projection), false);
+  });
+});
diff --git a/ts/test-node/maoyi/rendererMessageBridge_test.preload.ts b/ts/test-node/maoyi/rendererMessageBridge_test.preload.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bdbfc76c68276e25cfa38d84da548edb17485a15
--- /dev/null
+++ b/ts/test-node/maoyi/rendererMessageBridge_test.preload.ts
@@ -0,0 +1,715 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import assert from 'node:assert/strict';
+import type { IpcRendererEvent } from 'electron';
+
+import { createMaoyiRendererMessageBridge } from '../../maoyi/messageBridge.preload.ts';
+import {
+  projectMaoyiMessage,
+  type MaoyiMessageProjection,
+} from '../../maoyi/messageProjection.std.ts';
+import { projectMaoyiVisibleMessages } from '../../maoyi/visibleMessageProjection.std.ts';
+import {
+  clearMaoyiTranslationRuntime,
+  getMaoyiTranslation,
+} from '../../maoyi/translationRuntime.preload.ts';
+import {
+  clearMaoyiSmartReplyRuntime,
+  getMaoyiSmartReplies,
+  getMaoyiSmartReplyPending,
+} from '../../maoyi/smartReplyRuntime.preload.ts';
+import {
+  maoyiMessageCommandChannel,
+  maoyiMessageEventChannel,
+} from '../../maoyi/messageBridgeChannels.std.ts';
+
+const conversationId = '22222222-2222-4222-8222-222222222222';
+const otherConversationId = '44444444-4444-4444-8444-444444444444';
+const messageId = 'abcdefab-cdef-4abc-8def-abcdefabcdef';
+
+function projection(
+  overrides: Readonly<{
+    messageId?: string;
+    conversationId?: string;
+    text?: string;
+    timestamp?: number;
+    direction?: 'incoming' | 'outgoing';
+  }> = {}
+): MaoyiMessageProjection {
+  const value = projectMaoyiMessage({
+    id: overrides.messageId ?? messageId,
+    conversationId: overrides.conversationId ?? conversationId,
+    text: overrides.text ?? 'Hello world',
+    direction: overrides.direction ?? 'incoming',
+    timestamp: overrides.timestamp ?? 1_800_000_000_000,
+  });
+  assert.ok(value);
+  return value;
+}
+
+type InvocationBlocker = Readonly<{
+  type: string;
+  observed: Promise<void>;
+  markObserved: () => void;
+  wait: Promise<void>;
+  release: () => void;
+}>;
+
+function isVisibleBatch(value: unknown): value is Readonly<{
+  type: 'message.visibleBatch';
+  requestId: string;
+  conversationId: string;
+  messages: ReadonlyArray<MaoyiMessageProjection>;
+}> {
+  return (
+    typeof value === 'object' &&
+    value != null &&
+    'type' in value &&
+    value.type === 'message.visibleBatch' &&
+    'requestId' in value &&
+    typeof value.requestId === 'string' &&
+    'conversationId' in value &&
+    typeof value.conversationId === 'string' &&
+    'messages' in value &&
+    Array.isArray(value.messages)
+  );
+}
+
+function requestIdPlaceholder(value: object): '<uuid>' {
+  assert.ok(
+    'requestId' in value && typeof value.requestId === 'string',
+    'refresh request must carry a request UUID'
+  );
+  assert.match(
+    value.requestId,
+    /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
+  );
+  return '<uuid>';
+}
+
+class FakeRendererTransport {
+  public readonly invocations: Array<unknown> = [];
+  public listener:
+    | ((event: IpcRendererEvent, value: unknown) => void)
+    | undefined;
+  public blocker: InvocationBlocker | undefined;
+  public rejectedType: string | undefined;
+
+  public async invoke(channel: string, value: unknown): Promise<boolean> {
+    assert.equal(channel, maoyiMessageEventChannel);
+    this.invocations.push(value);
+    const blocker = this.blocker;
+    if (
+      blocker &&
+      typeof value === 'object' &&
+      value != null &&
+      'type' in value &&
+      value.type === blocker.type
+    ) {
+      blocker.markObserved();
+      await blocker.wait;
+      if (this.blocker === blocker) {
+        this.blocker = undefined;
+      }
+    }
+    if (
+      this.rejectedType &&
+      typeof value === 'object' &&
+      value != null &&
+      'type' in value &&
+      value.type === this.rejectedType
+    ) {
+      this.rejectedType = undefined;
+      return false;
+    }
+    return true;
+  }
+
+  public blockNext(type: string): InvocationBlocker {
+    let markObserved: (() => void) | undefined;
+    let release: (() => void) | undefined;
+    const blocker: InvocationBlocker = {
+      type,
+      observed: new Promise<void>(resolve => {
+        markObserved = resolve;
+      }),
+      markObserved: () => markObserved?.(),
+      wait: new Promise<void>(resolve => {
+        release = resolve;
+      }),
+      release: () => release?.(),
+    };
+    this.blocker = blocker;
+    return blocker;
+  }
+
+  public rejectNext(type: string): void {
+    this.rejectedType = type;
+  }
+
+  public on(
+    channel: string,
+    listener: (event: IpcRendererEvent, value: unknown) => void
+  ): void {
+    assert.equal(channel, maoyiMessageCommandChannel);
+    this.listener = listener;
+  }
+
+  public off(
+    channel: string,
+    listener: (event: IpcRendererEvent, value: unknown) => void
+  ): void {
+    assert.equal(channel, maoyiMessageCommandChannel);
+    if (this.listener === listener) {
+      this.listener = undefined;
+    }
+  }
+
+  public emit(value: unknown): void {
+    this.listener?.({} as IpcRendererEvent, value);
+  }
+}
+
+describe('Maoyi renderer message bridge', () => {
+  beforeEach(() => {
+    clearMaoyiTranslationRuntime();
+    clearMaoyiSmartReplyRuntime();
+  });
+  afterEach(() => {
+    clearMaoyiTranslationRuntime();
+    clearMaoyiSmartReplyRuntime();
+  });
+
+  it('publishes a canonical added message only for the announced current conversation', async () => {
+    const transport = new FakeRendererTransport();
+    const bridge = createMaoyiRendererMessageBridge(transport);
+    const value = projection();
+    let currentConversationId = conversationId;
+    bridge.setSnapshotProvider(() => ({
+      conversationId: currentConversationId,
+      messages: [value],
+    }));
+
+    await bridge.publishVisibleMessages(conversationId, [value]);
+    await bridge.publishAddedMessage(value);
+    assert.deepEqual(transport.invocations.at(-1), {
+      type: 'message.added',
+      ...value,
+    });
+
+    currentConversationId = otherConversationId;
+    await bridge.publishAddedMessage(value);
+    assert.equal(
+      transport.invocations.filter(
+        item =>
+          typeof item === 'object' &&
+          item != null &&
+          'type' in item &&
+          item.type === 'message.added'
+      ).length,
+      1
+    );
+
+    bridge.clear();
+    currentConversationId = conversationId;
+    await bridge.publishAddedMessage(value);
+    assert.equal(
+      transport.invocations.filter(
+        item =>
+          typeof item === 'object' &&
+          item != null &&
+          'type' in item &&
+          item.type === 'message.added'
+      ).length,
+      1
+    );
+    bridge.stop();
+  });
+
+  it('does not drop a queued added message when a visible publish follows immediately', async () => {
+    const transport = new FakeRendererTransport();
+    const bridge = createMaoyiRendererMessageBridge(transport);
+    const oldValue = projection({
+      messageId: '11111111-1111-4111-8111-111111111111',
+      text: 'Older English message',
+    });
+    const newValue = projection({
+      messageId: '33333333-3333-4333-8333-333333333333',
+      text: 'New English message',
+      timestamp: 1_800_000_000_001,
+    });
+    let snapshotMessages: ReadonlyArray<MaoyiMessageProjection> = [oldValue];
+    bridge.setSnapshotProvider(() => ({
+      conversationId,
+      messages: snapshotMessages,
+    }));
+
+    await bridge.publishVisibleMessages(conversationId, snapshotMessages);
+    const baseline = transport.invocations.length;
+    snapshotMessages = [oldValue, newValue];
+    const addedTask = bridge.publishAddedMessage(newValue);
+    const visibleTask = bridge.publishVisibleMessages(
+      conversationId,
+      snapshotMessages
+    );
+    await Promise.all([addedTask, visibleTask]);
+
+    const tail = transport.invocations.slice(baseline);
+    assert.deepEqual(tail[0], { type: 'message.added', ...newValue });
+    assert.ok(isVisibleBatch(tail[1]));
+    assert.deepEqual(tail[1].messages, snapshotMessages);
+    assert.equal(
+      tail.filter(
+        item =>
+          typeof item === 'object' &&
+          item != null &&
+          'type' in item &&
+          item.type === 'message.added'
+      ).length,
+      1
+    );
+    bridge.stop();
+  });
+
+  it('requests refresh only for one exact projection in the announced visible snapshot', async () => {
+    const transport = new FakeRendererTransport();
+    const bridge = createMaoyiRendererMessageBridge(transport);
