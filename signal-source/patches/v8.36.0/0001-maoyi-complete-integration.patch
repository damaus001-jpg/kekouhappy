+export function isMaoyiControlUuid(value: unknown): value is string {
+  return typeof value === 'string' && maoyiUuidPattern.test(value);
+}
+
+export function isMaoyiControlSourceHash(value: unknown): value is string {
+  return typeof value === 'string' && maoyiSourceHashPattern.test(value);
+}
+
+export function isMaoyiControlBusinessPayloadWithinLimit(
+  value: unknown
+): boolean {
+  try {
+    const serialized = JSON.stringify(value);
+    return (
+      typeof serialized === 'string' &&
+      Buffer.byteLength(serialized, 'utf8') <=
+        maoyiControlMaxBusinessPayloadBytes
+    );
+  } catch {
+    return false;
+  }
