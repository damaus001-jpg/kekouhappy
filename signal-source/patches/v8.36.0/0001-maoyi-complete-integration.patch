index 0000000000000000000000000000000000000000..63fbd1080959670b74c4978dcb4b1ae505c6de9c
--- /dev/null
+++ b/app/maoyi/bootstrap.main.ts
@@ -0,0 +1,35 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { createRequire } from 'node:module';
+import { join } from 'node:path';
+import { app, dialog } from 'electron';
+
+import { startMaoyiControlBridge } from './controlBridge.main.ts';
+import { runMaoyiStartupGuard } from './launchGuard.main.ts';
+import { startMaoyiMessageBridge } from './messageBridge.main.ts';
+import { startMaoyiWindowController } from './windowController.main.ts';
+
+try {
+  if (runMaoyiStartupGuard(app, dialog)) {
+    const controlBridge = startMaoyiControlBridge();
+    const windowController = startMaoyiWindowController(controlBridge);
+    const messageBridge = startMaoyiMessageBridge(
+      controlBridge,
+      windowController
+    );
+    app.once('before-quit', () => {
+      messageBridge.stop();
+      windowController.stop();
+      controlBridge.stop();
+    });
+    // The bootstrap and signal-main bundles are emitted into the same directory.
+    // oxlint-disable-next-line no-restricted-globals
+    createRequire(__filename)(join(__dirname, 'signal-main.js'));
+  }
+} catch {
+  if (process.env.MAOYI_SIGNAL_GUARD_TEST_AUTOCLOSE !== '1') {
+    dialog.showErrorBox('maoyi', '内置 Signal 启动校验失败');
+  }
+  app.exit(1);
+}
diff --git a/app/maoyi/controlBridge.main.ts b/app/maoyi/controlBridge.main.ts
new file mode 100644
index 0000000000000000000000000000000000000000..59c11e91034e09b9a546fe7fcd72262ea6ff986a
--- /dev/null
+++ b/app/maoyi/controlBridge.main.ts
@@ -0,0 +1,256 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import {
+  createMaoyiAuthResponse,
+  createMaoyiSignalEnvelope,
+  maoyiControlHeartbeatMs,
+  maoyiControlMaxMessageBytes,
+  maoyiControlReconnectMs,
+  parseMaoyiAuthChallenge,
+  verifyMaoyiLauncherEnvelope,
+  type MaoyiControlCommand,
+  type MaoyiControlEvent,
+} from './controlProtocol.node.ts';
+import { takeMaoyiLaunchContext } from './launchContext.main.ts';
+
+const controlBridgeKey = Symbol.for('maoyi.signal.control-bridge.v1');
+
+export type MaoyiControlBridge = Readonly<{
+  onCommand: (handler: (command: MaoyiControlCommand) => void) => () => void;
+  onTransportState: (handler: (authenticated: boolean) => void) => () => void;
+  setHeartbeatVisibleProvider: (provider: () => boolean) => void;
+  send: (event: MaoyiControlEvent) => boolean;
+  stop: () => void;
+}>;
+
+function schedule(
+  callback: () => void,
+  delay: number
+): ReturnType<typeof setTimeout> {
+  const timer = setTimeout(callback, delay);
+  timer.unref();
+  return timer;
+}
+
+export function getMaoyiControlBridge(): MaoyiControlBridge | undefined {
+  return Reflect.get(globalThis, controlBridgeKey) as
+    | MaoyiControlBridge
+    | undefined;
+}
+
+export function startMaoyiControlBridge(): MaoyiControlBridge {
+  const existing = getMaoyiControlBridge();
+  if (existing) {
+    return existing;
+  }
+
+  const launchContext = takeMaoyiLaunchContext();
+  if (!launchContext || launchContext.controlKey.length !== 32) {
+    throw new Error('Maoyi launch context is unavailable');
+  }
+  const context = launchContext;
+
+  const controlKey = Buffer.from(context.controlKey);
+  context.controlKey.fill(0);
+  const handlers = new Set<(command: MaoyiControlCommand) => void>();
+  const transportStateHandlers = new Set<(authenticated: boolean) => void>();
+  let heartbeatVisibleProvider = (): boolean => false;
+  let socket: WebSocket | undefined;
+  let reconnectTimer: ReturnType<typeof setTimeout> | undefined;
+  let heartbeatTimer: ReturnType<typeof setInterval> | undefined;
+  let authenticated = false;
+  let stopped = false;
+  let sendSequence = 0;
+  let receiveSequence = 0;
+
+  const notifyTransportState = (state: boolean): void => {
+    for (const handler of transportStateHandlers) {
+      try {
+        handler(state);
+      } catch {
+        // Transport observers cannot weaken or stop the authenticated bridge.
+      }
+    }
+  };
+
+  const clearTimers = (): void => {
+    if (reconnectTimer) {
+      clearTimeout(reconnectTimer);
+      reconnectTimer = undefined;
+    }
+    if (heartbeatTimer) {
+      clearInterval(heartbeatTimer);
+      heartbeatTimer = undefined;
+    }
+  };
+
+  const send = (event: MaoyiControlEvent): boolean => {
+    if (!authenticated || !socket || socket.readyState !== WebSocket.OPEN) {
+      return false;
+    }
+    sendSequence += 1;
+    socket.send(
+      createMaoyiSignalEnvelope(
+        controlKey,
+        context.appId,
+        process.pid,
+        sendSequence,
+        event
+      )
+    );
+    return true;
+  };
+
+  const stop = (): void => {
+    if (stopped) {
+      return;
+    }
+    stopped = true;
+    authenticated = false;
+    clearTimers();
+    try {
+      socket?.close();
+    } catch {
+      // A closing transport is already stopped.
+    }
+    socket = undefined;
+    handlers.clear();
+    transportStateHandlers.clear();
+    heartbeatVisibleProvider = (): boolean => false;
+    controlKey.fill(0);
+    Reflect.deleteProperty(globalThis, controlBridgeKey);
+  };
+
+  function scheduleReconnect(): void {
+    if (stopped || reconnectTimer) {
+      return;
+    }
+    reconnectTimer = schedule(() => {
+      reconnectTimer = undefined;
+      connect();
+    }, maoyiControlReconnectMs);
+  }
+
+  function connect(): void {
+    if (stopped) {
+      return;
+    }
+    authenticated = false;
+    sendSequence = 0;
+    receiveSequence = 0;
+    if (heartbeatTimer) {
+      clearInterval(heartbeatTimer);
+      heartbeatTimer = undefined;
+    }
+
+    try {
+      socket = new WebSocket(
+        `ws://127.0.0.1:${context.wsPort}?appId=${encodeURIComponent(context.appId)}`
+      );
+    } catch {
+      scheduleReconnect();
+      return;
+    }
+
+    socket.addEventListener('message', event => {
+      if (
+        stopped ||
+        typeof event.data !== 'string' ||
+        Buffer.byteLength(event.data, 'utf8') > maoyiControlMaxMessageBytes
+      ) {
+        socket?.close();
+        return;
+      }
+
+      if (!authenticated) {
+        const challenge = parseMaoyiAuthChallenge(event.data, context.appId);
+        if (!challenge) {
+          socket?.close();
+          return;
+        }
+        socket?.send(
+          createMaoyiAuthResponse(
+            controlKey,
+            context.appId,
+            process.pid,
+            challenge.challenge
+          )
+        );
+        authenticated = true;
+        notifyTransportState(true);
+        heartbeatTimer = setInterval(() => {
+          let visible = false;
+          try {
+            visible = heartbeatVisibleProvider();
+          } catch {
+            // A status provider cannot interrupt transport liveness.
+          }
+          send({ type: 'heartbeat', visible });
+        }, maoyiControlHeartbeatMs);
+        heartbeatTimer.unref();
+        return;
+      }
+
+      const expectedSequence = receiveSequence + 1;
+      const command = verifyMaoyiLauncherEnvelope(
+        event.data,
+        controlKey,
+        context.appId,
+        process.pid,
+        expectedSequence
+      );
+      if (
+        !command ||
+        (command.type === 'hello' && command.appId !== context.appId)
+      ) {
+        socket?.close();
+        return;
+      }
+      receiveSequence = expectedSequence;
+      for (const handler of handlers) {
+        try {
+          handler(command);
+        } catch {
+          // One command consumer cannot weaken or stop the authenticated bridge.
+        }
+      }
+    });
+    socket.addEventListener('close', () => {
+      authenticated = false;
+      notifyTransportState(false);
+      if (heartbeatTimer) {
+        clearInterval(heartbeatTimer);
+        heartbeatTimer = undefined;
+      }
+      scheduleReconnect();
+    });
+    socket.addEventListener('error', () => {
+      // The close event performs the bounded reconnect.
+    });
+  }
+
+  const bridge: MaoyiControlBridge = Object.freeze({
+    onCommand(handler: (command: MaoyiControlCommand) => void) {
+      handlers.add(handler);
+      return () => {
+        handlers.delete(handler);
+      };
+    },
+    onTransportState(handler: (authenticated: boolean) => void) {
+      transportStateHandlers.add(handler);
+      handler(authenticated);
+      return () => {
+        transportStateHandlers.delete(handler);
+      };
+    },
+    setHeartbeatVisibleProvider(provider: () => boolean) {
+      heartbeatVisibleProvider = provider;
+    },
+    send,
+    stop,
+  });
+  Reflect.set(globalThis, controlBridgeKey, bridge);
+  connect();
+  return bridge;
+}
