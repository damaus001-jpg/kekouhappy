+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import assert from 'node:assert/strict';
+
+import {
+  isMaoyiSmartReplyTrigger,
+  selectMaoyiSmartReplyContext,
+  selectMaoyiSmartReplyTriggerIds,
+} from '../../maoyi/smartReplyContext.std.ts';
+import {
+  projectMaoyiMessage,
+  type MaoyiMessageProjection,
+} from '../../maoyi/messageProjection.std.ts';
+
+const conversationId = '22222222-2222-4222-8222-222222222222';
+
+function projection(
+  index: number,
+  direction: 'incoming' | 'outgoing' = 'incoming'
+): MaoyiMessageProjection {
+  const hex = index.toString(16).padStart(8, '0');
+  const value = projectMaoyiMessage({
+    id: `${hex}-3333-7333-8333-333333333333`,
+    conversationId,
+    text: `English message ${index}`,
+    direction,
+    timestamp: 1_800_000_000_000 + index,
+  });
+  assert.ok(value);
+  return value;
+}
+
+describe('Maoyi smart reply context', () => {
+  it('selects at most eight canonical messages in original old-to-new order', () => {
+    const messages = Array.from({ length: 10 }, (_, index) =>
+      projection(index, index % 2 === 0 ? 'outgoing' : 'incoming')
+    );
+    const latest = messages[9];
+    assert.ok(latest);
+    const context = selectMaoyiSmartReplyContext(
+      conversationId,
+      messages,
+      latest
+    );
+    assert.deepEqual(context, messages.slice(2));
+    const stale = messages[8];
+    assert.ok(stale);
+    assert.equal(isMaoyiSmartReplyTrigger(latest, context), true);
+    assert.equal(isMaoyiSmartReplyTrigger(stale, context), false);
+  });
+
+  it('exposes the latest three incoming triggers even when the newest message is outgoing', () => {
+    const messages = [
+      projection(1, 'incoming'),
+      projection(2, 'outgoing'),
+      projection(3, 'incoming'),
+      projection(4, 'outgoing'),
+      projection(5, 'incoming'),
+      projection(6, 'incoming'),
+      projection(7, 'outgoing'),
+    ];
+    assert.deepEqual(
+      selectMaoyiSmartReplyTriggerIds(conversationId, messages),
+      [messages[2]?.messageId, messages[4]?.messageId, messages[5]?.messageId]
+    );
+    const middleTrigger = messages[4];
+    assert.ok(middleTrigger);
+    const context = selectMaoyiSmartReplyContext(
+      conversationId,
+      messages,
+      middleTrigger
+    );
+    assert.deepEqual(context, messages.slice(0, 5));
+    assert.equal(isMaoyiSmartReplyTrigger(middleTrigger, context), true);
+  });
+
+  it('rejects duplicate identities and cross-conversation projections', () => {
+    const value = projection(1);
+    assert.deepEqual(
+      selectMaoyiSmartReplyContext(conversationId, [value, value], value),
+      []
+    );
+    assert.deepEqual(
+      selectMaoyiSmartReplyContext(
+        conversationId,
+        [
+          {
+            ...projection(2),
+            conversationId: '44444444-4444-4444-8444-444444444444',
+          },
+        ],
+        value
+      ),
+      []
+    );
+  });
+});
