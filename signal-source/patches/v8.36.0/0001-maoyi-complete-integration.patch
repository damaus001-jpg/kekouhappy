+      ],
+    };
+    control.emitCommand(resultCommand);
+    control.emitCommand(resultCommand);
+    assert.equal(window.webContents.commands.length, 1);
+    assert.deepEqual(window.webContents.commands[0], resultCommand);
+
+    assert.equal(
+      ipc.handler(event, {
+        type: 'translation.cacheResultApplied',
+        requestId,
+        appliedCount: 1,
+      }),
