+          'requestId',
+          'conversationId',
+          'messageId',
+          'state',
+          'error',
+        ]) &&
+        (value.error === undefined || value.error === 'failed' || value.error === 'timeout' || value.error === 'busy') &&
+        isMaoyiControlUuid(value.requestId) &&
+        isMaoyiControlUuid(value.conversationId) &&
+        isMaoyiControlUuid(value.messageId) &&
